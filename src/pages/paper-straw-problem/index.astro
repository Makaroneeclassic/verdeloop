---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import PageHead from '../../components/PageHead.astro';
import { SITE } from '../../data/products';

/// ยิงตรงคำที่ร้านค้าค้นจริงตอนเจอปัญหา: "หลอดกระดาษเปื่อย" "หลอดกระดาษยุ่ย"
/// เป็นทั้งหน้า SEO และ landing page ของ ad group "แก้ปัญหาคู่แข่ง"
///
/// น้ำเสียงหน้านี้ต้องเป็นการอธิบายปัญหา ไม่ใช่ด่าหลอดกระดาษ
/// คนอ่านคือคนที่ "เลือกหลอดกระดาษมาเอง" เพราะอยากรักษ์โลก — ด่าของที่เขาเลือก = ด่าเขา
/// เข้าหาแบบ "คุณเลือกถูกแล้ว แต่วัสดุมันมีข้อจำกัดเชิงโครงสร้าง" จะได้ลีดมากกว่า
const title = 'หลอดกระดาษเปื่อยยุ่ย เกิดจากอะไร และแก้ได้อย่างไร';
const description =
  'อธิบายสาเหตุที่หลอดกระดาษเปื่อยยุ่ยกลางแก้ว ว่าเป็นเรื่องของโครงสร้างหลอดไม่ใช่คุณภาพยี่ห้อ พร้อมทางเลือกที่ยังย่อยสลายได้แต่ไม่เปื่อย และวิธีทดสอบก่อนสั่งจริง';

/// FAQPage schema — คำถามพวกนี้คือ long-tail ที่คนพิมพ์หาจริง
/// ตอบให้จบในตัว Google จะหยิบไปทำ rich snippet ได้
const faqs = [
  {
    q: 'ทำไมหลอดกระดาษถึงเปื่อยยุ่ย',
    a: 'เพราะหลอดกระดาษผลิตจากการนำแถบกระดาษมาม้วนซ้อนกันหลายชั้นแล้วยึดด้วยกาว ความแข็งแรงมาจากชั้นกาว เมื่อแช่น้ำนานพอ กาวจะอ่อนตัวและชั้นกระดาษเริ่มแยกจากกัน หลอดจึงนิ่มและยุบตัว เป็นข้อจำกัดเชิงโครงสร้างของวัสดุ ไม่ใช่เรื่องคุณภาพของยี่ห้อใดยี่ห้อหนึ่ง',
  },
  {
    q: 'เปลี่ยนยี่ห้อหลอดกระดาษแล้วจะหายเปื่อยไหม',
    a: 'ยี่ห้อที่ผนังหนากว่าจะยืดเวลาออกไปได้บ้าง แต่ไม่ได้แก้ที่ต้นเหตุ เพราะทุกยี่ห้อใช้วิธีม้วนกระดาษทากาวเหมือนกัน ถ้าต้องการให้หลอดอยู่ได้ตลอดแก้วโดยไม่แยกชั้น ต้องเปลี่ยนไปใช้วัสดุที่ขึ้นรูปเป็นเนื้อเดียวทั้งเส้น เช่น หลอดชานอ้อย',
  },
  {
    q: 'หลอดชานอ้อยต่างจากหลอดกระดาษอย่างไร',
    a: 'หลอดชานอ้อยขึ้นรูปจากเส้นใยเป็นตัวหลอดทั้งเส้นในครั้งเดียว ไม่มีรอยต่อและไม่มีชั้นกาวให้คลาย จึงไม่แยกชั้นเมื่อแช่น้ำ ขณะที่ยังย่อยสลายได้เองตามธรรมชาติเหมือนกัน และผ่านการรับรอง TUV Austria Home Compost',
  },
  {
    q: 'หลอดชานอ้อยยังย่อยสลายได้เหมือนหลอดกระดาษไหม',
    a: 'ได้ และผ่านการรับรอง Home Compostable จาก TUV Austria ซึ่งหมายความว่าย่อยสลายได้เองโดยไม่ต้องส่งโรงงานหมักปุ๋ยอุตสาหกรรม ทิ้งรวมกับเศษอาหารได้ ต่างจากหลอด PLA ที่ต้องส่งเข้าโรงงานเท่านั้น',
  },
  {
    q: 'จะทดสอบหลอดก่อนสั่งจำนวนมากได้อย่างไร',
    a: 'ขอตัวอย่างมาแช่กับเครื่องดื่มที่ร้านขายจริง ไม่ใช่แค่น้ำเปล่า เพราะน้ำแข็ง ความหวาน และความเป็นกรดมีผลต่อหลอด ทิ้งไว้ให้นานเท่ากับที่ลูกค้านั่งดื่มจริงในร้าน แล้วดูว่าหลอดยังคงรูปหรือเริ่มแยกชั้น',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: `${SITE.url}/` },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'หลอดกระดาษเปื่อยยุ่ย แก้อย่างไร',
        item: `${SITE.url}/paper-straw-problem/`,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];

/// ต้นทุนแฝง — เขียนเป็นผลกระทบเชิงคุณภาพ ไม่ใส่ตัวเลขบาท
/// เพราะยังไม่มีราคาจริงจากเจ้าของ และการเดาตัวเลขต้นทุนคือการโกหกลูกค้า B2B
const impacts = [
  {
    title: 'ลูกค้าขอหลอดใหม่กลางแก้ว',
    body: 'หลอดที่ยุบระหว่างดื่มทำให้ลูกค้าเดินกลับมาขอเปลี่ยน ซึ่งกินทั้งหลอดเพิ่มและเวลาพนักงานหน้าเคาน์เตอร์ในช่วงที่คิวยาวที่สุด',
  },
  {
    title: 'รีวิวลบที่ไม่ได้พูดถึงเครื่องดื่ม',
    body: 'รีวิวเรื่องหลอดปรากฏปนอยู่กับรีวิวรสชาติ ทำให้คะแนนร้านลดลงจากเรื่องที่ไม่เกี่ยวกับคุณภาพเครื่องดื่มเลย',
  },
  {
    title: 'เมนูท็อปปิ้งได้รับผลกระทบหนักสุด',
    body: 'ชานมไข่มุกและเมนูที่ต้องดูดแรงจะเร่งให้หลอดยุบเร็วกว่าปกติ และเป็นกลุ่มเมนูที่ราคาต่อแก้วสูงที่สุดของร้าน',
  },
  {
    title: 'ภาพลักษณ์รักษ์โลกไม่ถูกมองว่าเป็นความตั้งใจ',
    body: 'ร้านจ่ายแพงขึ้นเพื่อเลิกใช้พลาสติก แต่ลูกค้าจำได้แค่ว่าหลอดใช้ไม่ดี ความตั้งใจด้านสิ่งแวดล้อมจึงไม่ได้เครดิตอย่างที่ควรได้',
  },
];
---

<Base {title} {description} {schema}>
  <PageHead
    eyebrow="ปัญหาที่ร้านเจอจริง"
    heading="หลอดกระดาษเปื่อยยุ่ย เกิดจากอะไร"
    intro="ถ้าเปลี่ยนยี่ห้อมาหลายเจ้าแล้วยังเจอปัญหาเดิม ไม่ใช่เพราะเลือกยี่ห้อผิด แต่เป็นข้อจำกัดของตัววัสดุเอง หน้านี้อธิบายว่าทำไม และมีทางออกอะไรบ้าง"
    crumbs={[{ label: 'หน้าแรก', href: '/' }, { label: 'หลอดกระดาษเปื่อยยุ่ย' }]}
  />

  <article>
    <!-- สาเหตุ — ส่วนที่คนค้นหามาเพื่ออ่านโดยเฉพาะ วางไว้บนสุด -->
    <section class="mx-auto max-w-3xl px-5 sm:px-6 section-space-sm" aria-labelledby="cause">
      <p class="eyebrow">สาเหตุ</p>
      <h2 id="cause" class="mt-3 text-2xl font-medium text-forest-900">
        ปัญหาอยู่ที่วิธีผลิต ไม่ใช่ที่ยี่ห้อ
      </h2>
      <div class="mt-6 space-y-5 text-lg text-forest-800/90">
        <p>
          หลอดกระดาษเกือบทั้งหมดในตลาดผลิตด้วยวิธีเดียวกัน คือนำกระดาษเป็นแถบยาว
          มาม้วนเป็นเกลียวซ้อนกันสองถึงสามชั้น แล้วยึดแต่ละชั้นไว้ด้วยกาว
          ความแข็งของหลอดจึงมาจากชั้นกาวที่ยึดกระดาษไว้ ไม่ได้มาจากตัวกระดาษเอง
        </p>
        <p>
          เมื่อหลอดแช่อยู่ในเครื่องดื่ม น้ำจะค่อย ๆ ซึมเข้าไปตามแนวเกลียว
          พอกาวเริ่มอ่อนตัว ชั้นกระดาษจะคลายออกจากกัน หลอดจึงนิ่ม บวม และยุบเมื่อดูด
          <strong class="font-semibold text-forest-900">
            นี่คือเหตุผลที่หลอดกระดาษมักเปื่อยเป็นเกลียว
          </strong>
          — มันแยกตามรอยที่มันถูกม้วนขึ้นมานั่นเอง
        </p>
        <p>
          น้ำแข็งเร่งให้เกิดเร็วขึ้น เพราะทำให้ผิวหลอดเปียกตลอดเวลาและมีการเสียดสี
          ส่วนเครื่องดื่มร้อนยิ่งเร่งกว่านั้นมาก ด้วยเหตุนี้ร้านที่ขายเครื่องดื่มปั่นและชานมไข่มุก
          จึงเจอปัญหาหนักกว่าร้านที่ขายน้ำเปล่าอย่างเห็นได้ชัด
        </p>
      </div>

      <div
        class="mt-9 border border-cane-300/40 bg-cream-100 px-6 py-5"
        style="border-radius: var(--radius-card)"
      >
        <p class="font-medium text-forest-900">เพราะเป็นเรื่องโครงสร้าง การเปลี่ยนยี่ห้อจึงไม่ได้แก้</p>
        <p class="mt-2 text-forest-800/85">
          ยี่ห้อที่ผนังหนากว่าจะยืดเวลาออกไปได้บ้าง แต่ทุกเจ้าใช้วิธีม้วนกระดาษทากาวเหมือนกัน
          ปลายทางจึงเหมือนกัน ต่างกันแค่ช้าหรือเร็ว
        </p>
      </div>
    </section>

    <!-- ผลกระทบกับร้าน -->
    <section class="border-y border-forest-200/60 bg-cream-100" aria-labelledby="impact">
      <div class="mx-auto max-w-6xl px-5 sm:px-6 section-space-sm">
        <p class="eyebrow">ผลกระทบ</p>
        <h2 id="impact" class="mt-3 text-2xl font-medium text-forest-900">
          ต้นทุนที่ไม่ได้อยู่ในใบเสนอราคา
        </h2>
        <p class="mt-3 max-w-2xl text-forest-800/85">
          ราคาต่อชิ้นของหลอดกระดาษมักถูกกว่า แต่ต้นทุนจริงของร้านไม่ได้จบที่ราคาหลอด
        </p>

        <div class="mt-8 grid gap-6 sm:grid-cols-2">
          {
            impacts.map((im, i) => (
              <div class="grid grid-cols-[2.5rem_1fr] gap-x-4 border-t border-forest-200/70 pt-5">
                <span class="index-num text-lg text-cane-500" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <div>
                  <h3 class="font-medium text-forest-900">{im.title}</h3>
                  <p class="mt-2 text-sm text-forest-800/85">{im.body}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ทางเลือก -->
    <section class="mx-auto max-w-3xl px-5 sm:px-6 section-space-sm" aria-labelledby="options">
      <p class="eyebrow">ทางเลือก</p>
      <h2 id="options" class="mt-3 text-2xl font-medium text-forest-900">
        ทางออกที่มี และข้อจำกัดของแต่ละทาง
      </h2>

      <dl class="mt-7 divide-y divide-forest-200/70 border-y border-forest-200/70">
        <div class="py-5">
          <dt class="font-medium text-forest-900">กลับไปใช้หลอดพลาสติก</dt>
          <dd class="mt-2 text-forest-800/85">
            แก้ปัญหาเปื่อยได้ทันที แต่ย้อนกลับไปเจอปัญหาเดิมที่เป็นเหตุให้เปลี่ยนมาแต่แรก
            และร้านที่สื่อสารเรื่องรักษ์โลกไปแล้วจะอธิบายกับลูกค้าได้ยาก
          </dd>
        </div>
        <div class="py-5">
          <dt class="font-medium text-forest-900">เปลี่ยนไปใช้หลอด PLA</dt>
          <dd class="mt-2 text-forest-800/85">
            ไม่เปื่อยเพราะเป็นพลาสติกชีวภาพ แต่ย่อยสลายได้เฉพาะในโรงงานหมักปุ๋ยอุตสาหกรรม
            ถ้าร้านทิ้งลงถังขยะทั่วไป ผลลัพธ์ปลายทางแทบไม่ต่างจากพลาสติก
            และ PLA ยังอ่อนตัวกับเครื่องดื่มร้อน
          </dd>
        </div>
        <div class="py-5">
          <dt class="font-medium text-forest-900">ไม่ใช้หลอดเลย ใช้ฝาแบบดื่มได้</dt>
          <dd class="mt-2 text-forest-800/85">
            เหมาะกับเครื่องดื่มบางประเภท แต่ใช้กับเมนูปั่นและเมนูท็อปปิ้งไม่ได้
            และต้องเปลี่ยนฝาทั้งระบบซึ่งเป็นต้นทุนก้อนใหญ่กว่าเปลี่ยนหลอด
          </dd>
        </div>
        <div class="py-5">
          <dt class="font-medium text-forest-900">เปลี่ยนไปใช้หลอดชานอ้อย</dt>
          <dd class="mt-2 text-forest-800/85">
            ขึ้นรูปจากเส้นใยเป็นเนื้อเดียวทั้งเส้น ไม่มีชั้นกาวให้คลาย จึงไม่แยกชั้นเมื่อแช่น้ำ
            และยังย่อยสลายเองได้ตามธรรมชาติ ผ่านการรับรอง Home Compost
            จึงไม่ต้องเปลี่ยนวิธีทิ้งขยะของร้าน
          </dd>
        </div>
      </dl>

      <p class="mt-8">
        <a
          href="/compare/"
          class="border-b-2 border-cane-500 pb-1 font-semibold text-forest-800 hover:border-forest-800"
        >
          ดูตารางเทียบทั้งสามวัสดุแบบละเอียด
        </a>
      </p>
    </section>

    <!-- วิธีทดสอบ — ให้เครื่องมือตัดสินใจ ไม่ใช่ให้เชื่อเรา -->
    <section class="border-y border-forest-200/60 bg-cream-100" aria-labelledby="test">
      <div class="mx-auto max-w-3xl px-5 sm:px-6 section-space-sm">
        <p class="eyebrow">ก่อนสั่งจำนวนมาก</p>
        <h2 id="test" class="mt-3 text-2xl font-medium text-forest-900">
          ทดสอบหลอดด้วยตัวเองอย่างไรให้ได้ผลจริง
        </h2>
        <p class="mt-4 text-forest-800/85">
          อย่าเชื่อคำโฆษณาของใครรวมถึงของเรา วิธีที่แน่นอนที่สุดคือทดสอบกับของจริงที่ร้านขาย
        </p>

        <ol class="mt-7 divide-y divide-forest-200/70 border-y border-forest-200/70">
          <li class="grid grid-cols-[2.5rem_1fr] gap-x-4 py-4">
            <span class="index-num text-lg text-cane-500" aria-hidden="true">01</span>
            <span class="text-forest-900">
              ใช้เครื่องดื่มที่ร้านขายจริง ไม่ใช่น้ำเปล่า — ความหวาน กรด และนมมีผลต่อหลอดต่างกัน
            </span>
          </li>
          <li class="grid grid-cols-[2.5rem_1fr] gap-x-4 py-4">
            <span class="index-num text-lg text-cane-500" aria-hidden="true">02</span>
            <span class="text-forest-900">ใส่น้ำแข็งเท่าที่ใส่จริง เพราะน้ำแข็งเร่งการเปื่อย</span>
          </li>
          <li class="grid grid-cols-[2.5rem_1fr] gap-x-4 py-4">
            <span class="index-num text-lg text-cane-500" aria-hidden="true">03</span>
            <span class="text-forest-900">
              แช่ทิ้งไว้ให้นานเท่ากับที่ลูกค้านั่งดื่มจริงในร้าน ไม่ใช่แค่ห้านาที
            </span>
          </li>
          <li class="grid grid-cols-[2.5rem_1fr] gap-x-4 py-4">
            <span class="index-num text-lg text-cane-500" aria-hidden="true">04</span>
            <span class="text-forest-900">
              ลองดูดจริงตอนท้าย ดูว่าหลอดยุบหรือแยกชั้นไหม — การมองอย่างเดียวไม่พอ
            </span>
          </li>
          <li class="grid grid-cols-[2.5rem_1fr] gap-x-4 py-4">
            <span class="index-num text-lg text-cane-500" aria-hidden="true">05</span>
            <span class="text-forest-900">
              ทดสอบเทียบกับหลอดที่ใช้อยู่ตอนนี้ไปพร้อมกัน จะเห็นความต่างชัดกว่าทดสอบแยก
            </span>
          </li>
        </ol>
      </div>
    </section>

    <!-- FAQ ตรงกับ schema ด้านบน -->
    <section class="mx-auto max-w-3xl px-5 sm:px-6 section-space-sm" aria-labelledby="faq">
      <p class="eyebrow">คำถามที่พบบ่อย</p>
