---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import PageHead from '../../components/PageHead.astro';
import { CONTACT, PRODUCTS, SITE } from '../../data/products';

/// หน้านี้กิน rich snippet ของ Google ผ่าน FAQPage schema — คำถามคือ long-tail ที่คนพิมพ์หาจริง
///
/// ⚠️ กฎเหล็กของหน้านี้: 4 คำถามที่ขายดีที่สุด (แช่ได้กี่ชม. / ย่อยกี่วัน / เก็บได้นานแค่ไหน /
/// พิมพ์โลโก้ขั้นต่ำเท่าไหร่) ยังไม่มีตัวเลขยืนยันจากฝ่ายผลิต
/// ทางออกคือ "ตอบสิ่งที่ยืนยันได้ แล้วส่งต่อให้ถาม" ไม่ใช่เว้นคำถามทิ้ง และไม่ใช่เดาตัวเลข
///   - เว้นทิ้ง = เสีย long-tail keyword ที่มีเจตนาซื้อสูงสุด และคนอ่านคิดว่าเราปิดบัง
///   - เดาตัวเลข = ฝ่ายจัดซื้อเอาไปเทียบกับของจริงแล้วไม่ตรง เสียลูกค้าถาวร
/// คำตอบเชิงโครงสร้าง (ไม่มีชั้นกาวให้คลาย) ขายได้จริงกว่าตัวเลขชั่วโมงอยู่แล้ว
/// เพราะปิดท้ายด้วยการชวนขอตัวอย่างไปทดสอบ = ได้ลีด
///
/// พอได้ตัวเลขจริงมา: แก้ที่ answer ของคำถามนั้นอย่างเดียว schema อัปเดตตามเอง
const title = 'คำถามที่พบบ่อยเรื่องหลอดชานอ้อย';
const description =
  'รวมคำถามที่ร้านค้าและฝ่ายจัดซื้อถามบ่อยเรื่องหลอดชานอ้อย ทั้งเรื่องความทนน้ำ การย่อยสลาย ใบรับรอง การเก็บรักษา การพิมพ์โลโก้ และการสั่งซื้อ พร้อมคำตอบตรงไปตรงมา';

/// จัดกลุ่มตามลำดับที่คนตัดสินใจจริง: ใช้ได้ไหม → รักษ์โลกจริงไหม → สั่งยังไง → ใช้ในรายงานได้ไหม
const groups: { id: string; label: string; qa: { q: string; a: string }[] }[] = [
  {
    id: 'usage',
    label: 'การใช้งานหน้าร้าน',
    qa: [
      {
        q: 'หลอดชานอ้อยแช่ในเครื่องดื่มได้นานแค่ไหน ไม่เปื่อยเหรอ',
        a: 'ไม่เปื่อยยุ่ยแบบหลอดกระดาษ เพราะโครงสร้างต่างกันคนละแบบ หลอดกระดาษคือกระดาษหลายชั้นม้วนซ้อนแล้วยึดด้วยกาว พอแช่น้ำนานกาวจะอ่อนตัวและชั้นกระดาษแยกออกจากกัน ส่วนหลอดชานอ้อยขึ้นรูปจากเส้นใยเป็นเนื้อเดียวทั้งเส้น ไม่มีชั้นกาวให้คลาย จึงไม่แยกชั้น ทั้งนี้ระยะเวลาที่ใช้ได้จริงขึ้นกับชนิดเครื่องดื่ม ปริมาณน้ำแข็ง และอุณหภูมิ เราจึงแนะนำให้ขอตัวอย่างไปแช่กับเครื่องดื่มที่ร้านขายจริงก่อนตัดสินใจ',
      },
      {
        q: 'ใช้กับเครื่องดื่มร้อนได้ไหม',
        a: 'แนะนำให้เริ่มใช้งานกับเครื่องดื่มเย็นก่อน หลอดชานอ้อยแต่ละสูตรมีช่วงอุณหภูมิใช้งานต่างกัน จึงไม่ควรเหมารวมว่าทุกรุ่นใช้กับเครื่องดื่มร้อนได้ หากร้านมีเมนูร้อน กรุณาแจ้งอุณหภูมิและลักษณะการใช้งานให้ทีมงานยืนยันสเปกของรุ่นสินค้าก่อน',
      },
      {
        q: 'ทำไมสีของหลอดชานอ้อยจึงอาจต่างกันเล็กน้อย',
        a: 'เส้นใยจากพืชอาจให้เฉดสีต่างกันตามวัตถุดิบและล็อตการผลิต ควรดูตัวอย่างสินค้าจริงเพื่อเลือกให้เข้ากับร้าน หากพบความผิดปกติอื่น เช่น ความชื้น รา หรือการเสียรูป ให้แยกสินค้านั้นและติดต่อทีมงานก่อนใช้',
      },
      {
        q: 'มีกลิ่นหรือรสติดเครื่องดื่มไหม',
        a: 'ไม่ทิ้งรสกระดาษในเครื่องดื่ม ซึ่งเป็นข้อร้องเรียนที่พบบ่อยที่สุดของหลอดกระดาษ โดยเฉพาะกับเครื่องดื่มรสอ่อนอย่างชาและน้ำผลไม้ที่กลิ่นกระดาษกลบรสเดิม',
      },
      {
        q: 'ใช้เจาะฝาซีลชานมไข่มุกได้ไหม',
        a: 'ได้ ให้ใช้ขนาด 12 มม. ซึ่งเป็นขนาดที่ออกแบบมาสำหรับชานมไข่มุก พุดดิ้ง และเฉาก๊วยโดยเฉพาะ ทั้งปากหลอดที่กว้างพอให้ไข่มุกผ่าน และความแข็งแรงที่เจาะฝาซีลได้โดยไม่ยับ',
      },
      {
        q: 'ควรเลือกขนาดไหนให้ร้าน',
        a: `เลือกตามเมนูที่ขาย ${PRODUCTS.map((p) => `${p.shortName} สำหรับ${p.useCase}`).join(' · ')} ร้านส่วนใหญ่ใช้สองขนาดคู่กัน คือขนาดเล็กสำหรับเครื่องดื่มทั่วไปและขนาดใหญ่สำหรับเมนูท็อปปิ้ง การเลือกขนาดให้พอดีกับเมนูยังช่วยลดคาร์บอนฟุตพริ้นต์ด้วย เพราะหลอดใหญ่ใช้วัสดุมากกว่า`,
      },
    ],
  },
  {
    id: 'compost',
    label: 'การย่อยสลายและใบรับรอง',
    qa: [
      {
        q: 'ย่อยสลายได้จริงไหม ต้องส่งโรงงานหรือเปล่า',
        a: 'ย่อยสลายได้เองโดยไม่ต้องส่งโรงงาน ผ่านการรับรอง Home Compost จาก TUV Austria ซึ่งหมายความว่าย่อยสลายได้ในสภาพแวดล้อมทั่วไป ไม่ต้องการอุณหภูมิสูงเป็นพิเศษ ทางร้านจึงทิ้งรวมกับเศษอาหารได้เลย ไม่ต้องแยกถังหรือเปลี่ยนระบบจัดการขยะ',
      },
      {
        q: 'Home Compostable ต่างจาก Industrial Compostable อย่างไร',
        a: 'Home Compostable ย่อยสลายได้เองในสภาพแวดล้อมทั่วไป ส่วน Industrial Compostable ต้องส่งเข้าโรงงานหมักปุ๋ยที่ควบคุมอุณหภูมิราว 55 ถึง 60 องศาเซลเซียสเท่านั้น หลอด PLA อยู่ในกลุ่มหลัง ซึ่งหมายความว่าถ้าร้านทิ้งลงถังขยะทั่วไป ผลลัพธ์ปลายทางแทบไม่ต่างจากพลาสติก ประเทศไทยยังมีโรงงานรองรับไม่ทั่วถึง ความต่างข้อนี้จึงมีผลจริงกับร้านค้า',
      },
      {
        q: 'ใช้เวลาย่อยสลายกี่วัน',
        a: 'ระยะเวลาย่อยสลายจริงขึ้นอยู่กับสภาพแวดล้อมที่ทิ้ง ทั้งความชื้น อุณหภูมิ และจุลินทรีย์ในบริเวณนั้น ตัวเลขวันจึงต่างกันตามสถานที่ สิ่งที่ยืนยันได้คือผ่านมาตรฐาน Home Compost ของ TUV Austria ซึ่งกำหนดเกณฑ์เวลาและระดับการย่อยสลายไว้ชัดเจนอยู่แล้ว ต้องการเอกสารรับรองฉบับเต็มที่ระบุเงื่อนไขการทดสอบ ขอได้ทาง LINE',
      },
      {
        q: 'มีใบรับรองอะไรบ้าง',
        a: 'ใบรับรองหลักคือ TUV Austria Home Compost และ ISO 14067 สำหรับคาร์บอนฟุตพริ้นต์ผลิตภัณฑ์ นอกจากนี้ยังมี ISO 9001 ISO 22000 HACCP มาตรฐานความปลอดภัยอาหาร FDA และ EU No.10/2011 รวมถึง PFAS Free และ Gluten Free ดูรายละเอียดทั้งหมดได้ที่หน้าใบรับรอง',
      },
      {
        q: 'ทำจากอะไร ต้องปลูกอ้อยเพิ่มเพื่อทำหลอดไหม',
        a: 'ทำจากชานอ้อยซึ่งเป็นกากที่เหลือจากการหีบน้ำตาล เป็นของที่เกิดขึ้นอยู่แล้วจากอุตสาหกรรมน้ำตาลและเดิมส่วนหนึ่งถูกกำจัดทิ้ง การนำมาขึ้นรูปเป็นหลอดจึงเป็นการใช้ประโยชน์จากของเหลือ ไม่ได้เพิ่มพื้นที่เพาะปลูกใหม่ ต่างจากพลาสติกชีวภาพบางชนิดที่ใช้พืชอาหารเป็นวัตถุดิบตั้งต้นโดยตรง',
      },
    ],
  },
  {
    id: 'order',
    label: 'การสั่งซื้อและบรรจุภัณฑ์',
    qa: [
      {
        q: 'หนึ่งกล่องมีกี่ชิ้น',
        a: `จำนวนต่อกล่องต่างกันตามขนาดหลอด ${PRODUCTS.map(
          (p) =>
            `${p.shortName} กล่องใหญ่ ${p.packing[0].pieces.toLocaleString('th-TH')} ชิ้น (${p.packing[0].packs} แพค แพคละ ${p.packing[0].perPack})`,
        ).join(' · ')} ทุกขนาดมีกล่องรีแพคขนาดเล็กลงครึ่งหนึ่งให้เลือกด้วย เหมาะกับร้านที่พื้นที่เก็บของจำกัด`,
      },
      {
        q: 'หลอดห่อซองแยกชิ้นไหม',
        a: 'ห่อซองกระดาษรายชิ้นทุกหลอด ตอบโจทย์เรื่องสุขอนามัยหน้าร้านและร้านที่ต้องวางหลอดให้ลูกค้าหยิบเอง',
      },
      {
        q: 'พิมพ์โลโก้ร้านบนซองได้ไหม',
        a: 'รับผลิตซองพิมพ์โลโก้ได้ โดยมีจำนวนขั้นต่ำต่อครั้งเนื่องจากต้องทำแม่พิมพ์ ตัวเลขขั้นต่ำและระยะเวลาผลิตขึ้นอยู่กับแบบที่ใช้ กรุณาแจ้งแบบโลโก้และปริมาณที่ต้องการมาทาง LINE เพื่อขอใบเสนอราคาที่ตรงกับงานจริง',
      },
      {
        q: 'สั่งขั้นต่ำเท่าไหร่ ราคาเท่าไหร่',
        a: 'ราคาขึ้นอยู่กับขนาดหลอดและปริมาณที่สั่งต่อครั้ง แจ้งขนาดที่สนใจและปริมาณที่ใช้ต่อเดือนมาทาง LINE หรือกรอกฟอร์มขอใบเสนอราคา ทีมงานจะส่งราคาที่ตรงกับปริมาณของคุณกลับไป พร้อมส่งตัวอย่างให้ทดลองก่อนตัดสินใจ',
      },
      {
        q: 'ขอตัวอย่างมาทดลองก่อนได้ไหม',
        a: 'ได้ และแนะนำให้ทำก่อนสั่งจำนวนมากทุกครั้ง กรอกฟอร์มขอตัวอย่างพร้อมระบุขนาดที่สนใจ เราจะจัดส่งให้ทดลองแช่กับเครื่องดื่มที่ร้านขายจริง วิธีทดสอบที่ให้ผลแม่นยำที่สุดคือทดสอบเทียบกับหลอดที่ใช้อยู่ตอนนี้ไปพร้อมกัน',
      },
      {
        q: 'เก็บรักษาอย่างไร',
        a: 'เก็บที่อุณหภูมิห้องในที่แห้ง หลีกเลี่ยงแดด ความร้อน และความชื้น เช่น บริเวณข้างอ่างล้าง ปิดบรรจุภัณฑ์หลังเปิดใช้ และหยิบล็อตเก่ามาใช้ก่อน อายุการเก็บให้ยึดวันผลิตและคำแนะนำบนกล่องของแต่ละล็อต หากต้องการเอกสารสำหรับฝ่ายจัดซื้อ ขอได้ทาง LINE',
      },
    ],
  },
  {
    id: 'esg',
    label: 'สำหรับองค์กรและรายงาน ESG',
    qa: [
      {
        q: 'มีตัวเลขคาร์บอนฟุตพริ้นต์ให้ใส่รายงานไหม',
        a: `มี และตรวจวัดตามมาตรฐาน ISO 14067 ทุกขนาด ค่าต่อหลอดคือ ${PRODUCTS.map((p) => `${p.shortName} ${p.co2PerStraw} กรัม CO2e`).join(' · ')} นำไปคูณกับปริมาณที่องค์กรใช้จริงเพื่อรายงานใน Scope 3 หมวดสินค้าและบริการที่จัดซื้อได้โดยตรง หน้า ESG มีเครื่องคำนวณให้ใส่จำนวนแก้วต่อวันแล้วได้ตัวเลขทั้งปีทันที`,
      },
      {
        q: 'ขอเอกสารรับรองตัวจริงเพื่อแนบรายงานได้ไหม',
        a: 'ได้ แจ้งมาทาง LINE ว่าต้องการใบรับรองฉบับใดและใช้กับงานอะไร ทีมงานจะส่งไฟล์ให้ ฝ่ายจัดซื้อและฝ่ายความยั่งยืนนำไปแนบประกอบรายงานได้',
      },
      {
        q: 'ออกใบกำกับภาษีในนามบริษัทได้ไหม',
        a: `ได้ การสั่งซื้อดำเนินการในนาม ${CONTACT.company} ออกเอกสารสำหรับงานจัดซื้อขององค์กรได้ตามปกติ แจ้งข้อมูลบริษัทมาพร้อมคำสั่งซื้อได้เลย`,
      },
    ],
  },
];

/// รวมทุกคำถามเข้า FAQPage เดียว — Google อ่าน schema เดียวต่อหน้า
/// คำตอบใน schema ต้องตรงกับที่แสดงบนหน้าเป๊ะ ๆ ไม่งั้นถือว่า cloaking
const allQa = groups.flatMap((g) => g.qa);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'คำถามที่พบบ่อย', item: `${SITE.url}/faq/` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: allQa.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<Base {title} {description} {schema}>
  <PageHead
    eyebrow="คำถามที่พบบ่อย"
    heading="คำถามที่ร้านค้าถามบ่อยที่สุด"
    intro="รวมคำถามจากร้านค้าและฝ่ายจัดซื้อ ตอบตรงไปตรงมา เรื่องไหนที่ตัวเลขขึ้นอยู่กับหน้างานจริง เราบอกตามนั้นแทนที่จะให้ตัวเลขที่ใช้อ้างอิงไม่ได้"
    crumbs={[{ label: 'หน้าแรก', href: '/' }, { label: 'คำถามที่พบบ่อย' }]}
  />

  <div class="mx-auto max-w-3xl px-5 sm:px-6 section-space-sm">
    <!-- สารบัญ — หน้านี้ยาว คนมาจาก Google มักมาหาคำตอบเดียว -->
    <nav aria-label="หัวข้อคำถาม">
      <p class="eyebrow">ข้ามไปที่หัวข้อ</p>
      <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-2.5">
        {
          groups.map((g) => (
            <li>
              <a
                href={`#${g.id}`}
                class="border-b-2 border-cane-500/70 pb-0.5 text-sm font-medium text-forest-800 hover:border-forest-800"
              >
                {g.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      groups.map((g) => (
        <section class="mt-14 scroll-mt-24" id={g.id} aria-labelledby={`h-${g.id}`}>
          <h2 id={`h-${g.id}`} class="text-2xl font-medium text-forest-900">
            {g.label}
          </h2>

          {/* details/summary เปิดปิดได้โดยไม่ต้องใช้ JS
              เนื้อหาอยู่ใน DOM ตลอด Google จึงอ่านเจอทุกคำตอบแม้ยังไม่ได้กางออก */}
          <div class="mt-6 divide-y divide-forest-200/70 border-y border-forest-200/70">
            {g.qa.map((f) => (
              <details class="group py-4">
                <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-medium text-forest-900">
                  <h3 class="text-base font-medium">{f.q}</h3>
                  <span
                    class="mt-0.5 shrink-0 text-lg leading-none text-cane-600 transition group-open:rotate-45"
                    aria-hidden="true"
                  >
                    +
                  </span>
                </summary>
                <p class="mt-3 text-forest-800/85">{f.a}</p>
              </details>
            ))}
          </div>
        </section>
      ))
    }

    <!-- ทางออกสำหรับคำถามที่ไม่มีในหน้า — กันคนออกจากเว็บไปถาม Google ต่อ -->
    <section class="mt-16 border border-cane-300/40 bg-cream-100 px-6 py-6" style="border-radius: var(--radius-card)">
      <h2 class="font-medium text-forest-900">ไม่เจอคำถามที่ต้องการ</h2>
      <p class="mt-2 text-forest-800/85">
        ทักมาถามได้โดยตรง{' '}
        ทาง LINE ผ่านปุ่มที่ส่วนท้ายเว็บไซต์
        
        {' '}คำถามเรื่องสเปกเชิงเทคนิคและเอกสารสำหรับงานจัดซื้อ ตอบได้ทั้งหมด
      </p>
    </section>

    <!-- ลิงก์ต่อ — ส่งไปหน้าที่ตอบลึกกว่าในเรื่องเดียวกัน -->
    <nav class="mt-12" aria-label="อ่านต่อ">
      <p class="eyebrow">อ่านต่อ</p>
      <ul class="mt-4 space-y-3">
        <li>
          <a
            href="/compare/"
            class="border-b-2 border-cane-500 pb-1 font-semibold text-forest-800 hover:border-forest-800"
          >
            ตารางเทียบ ชานอ้อย vs กระดาษ vs PLA แบบละเอียด
          </a>
        </li>
        <li>
          <a
            href="/paper-straw-problem/"
            class="border-b-2 border-cane-500 pb-1 font-semibold text-forest-800 hover:border-forest-800"
          >
            ทำไมหลอดกระดาษถึงเปื่อยยุ่ย และแก้อย่างไร
          </a>
        </li>
        <li>
          <a
            href="/esg/"
            class="border-b-2 border-cane-500 pb-1 font-semibold text-forest-800 hover:border-forest-800"
          >
            คำนวณคาร์บอนฟุตพริ้นต์สำหรับรายงาน ESG
          </a>
        </li>
        <li>
          <a
            href="/certifications/"
            class="border-b-2 border-cane-500 pb-1 font-semibold text-forest-800 hover:border-forest-800"
          >
            ดูใบรับรองทั้งหมด
          </a>
        </li>
      </ul>
    </nav>
  </div>

  <CtaBand
    heading="ถามแล้วยังไม่แน่ใจ ลองของจริงเลย"
    sub="ขอตัวอย่างฟรีไปทดสอบกับเครื่องดื่มของร้านคุณ ตอบได้ทุกคำถามที่ยังค้างอยู่"
  />
</Base>
