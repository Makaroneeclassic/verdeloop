---
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/CtaBand.astro';
import PageHead from '../../components/PageHead.astro';
import { CERTIFICATIONS, CONTACT, PRODUCTS, SITE } from '../../data/products';

export function getStaticPaths() {
  return PRODUCTS.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product: p } = Astro.props;
const others = PRODUCTS.filter((x) => x.slug !== p.slug);

const title = `หลอดชานอ้อย ${p.shortName} (${p.dimensions}) ไม่เปื่อยยุ่ย ราคาส่ง`;

const url = `${SITE.url}/products/${p.slug}/`;

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: p.name,
    description: p.metaDescription,
    image: p.images.map((i) => i.src),
    brand: { '@type': 'Brand', name: SITE.name },
    material: 'ชานอ้อย (Sugarcane bagasse)',
    size: p.dimensions,
    url,
    offers: {
      '@type': 'Offer',
      availability: 'https://schema.org/InStock',
      priceCurrency: 'THB',
      url,
      // ราคาเป็นแบบขายส่งต่อรอง — ไม่ประกาศตัวเลข ให้ติดต่อสอบถาม
      priceSpecification: {
        '@type': 'PriceSpecification',
        priceCurrency: 'THB',
        valueAddedTaxIncluded: false,
      },
      seller: { '@type': 'Organization', name: SITE.name },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: `${SITE.url}/` },
      { '@type': 'ListItem', position: 2, name: 'สินค้า', item: `${SITE.url}/products/` },
      { '@type': 'ListItem', position: 3, name: p.name, item: url },
    ],
  },
];

const specs = [
  { label: 'ขนาด', value: p.dimensions },
  { label: 'วัตถุดิบ', value: 'ชานอ้อยและเส้นใยพืชธรรมชาติ' },
  { label: 'การห่อ', value: 'ห่อซองกระดาษรายชิ้น' },
  { label: 'คาร์บอนฟุตพริ้นต์', value: `${p.co2PerStraw} กรัม CO₂e ต่อหลอด (ISO 14067)` },
  { label: 'การย่อยสลาย', value: 'Home Compostable — ย่อยสลายเองได้ในธรรมชาติ' },
  { label: 'มาตรฐาน', value: 'TUV Austria Home Compost, FDA, EU No.10/2011, PFAS Free' },
];
---

<!-- ภาพแชร์ใช้การ์ดที่ประกอบไว้ ไม่ใช่ p.images[0] ซึ่งพื้นโปร่งใส — LINE จะเรนเดอร์พื้นใสเป็นสีดำ -->
<Base title={title} description={p.metaDescription} image={`/img/og/og-${p.slug}.jpg`} {schema}>
  <article>
    <PageHead
      eyebrow={`Home Compostable · ${p.dimensions}`}
      heading={`หลอดชานอ้อย ${p.shortName}`}
      intro={`${p.useCase} แช่อยู่ในแก้วได้ตลอดการดื่มโดยไม่เปื่อยยุ่ย และย่อยสลายเองได้ในธรรมชาติหลังใช้งาน`}
      crumbs={[
        { label: 'หน้าแรก', href: '/' },
        { label: 'สินค้า', href: '/products/' },
        { label: `หลอดชานอ้อย ${p.shortName}` },
      ]}
    >
      <div class="mt-9 flex flex-wrap gap-3">
        <a
          href="/sample/"
          class="bg-cream-100 px-6 py-3.5 font-semibold text-forest-900 transition hover:bg-cream-50"
          style="border-radius: var(--radius-sharp)"
        >
          ขอตัวอย่างฟรี
        </a>
        <a
          href={CONTACT.lineUrl}
          class="px-6 py-3.5 font-semibold text-cream-50 ring-1 ring-cream-200/40 transition hover:bg-forest-800"
          style="border-radius: var(--radius-sharp)"
        >
          สอบถามราคาทาง LINE
        </a>
      </div>
    </PageHead>

    <!-- รูปสินค้า + เมนูที่เหมาะ -->
    <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 lg:grid-cols-[1fr_1fr] lg:gap-16">
      <div class="grid grid-cols-2 gap-4">
        {/* รูปลบพื้นขาวออกแล้ว จึงไม่ต้องมีกล่องครีมรอง — หลอดลอยอยู่บนพื้นหน้าเว็บตรง ๆ ไม่มีกรอบสี่เหลี่ยม
            width/height ดึงจากไฟล์ข้อมูล ไม่ใช่เลขที่เดาไว้ ไม่งั้นเบราว์เซอร์จองพื้นที่ผิดแล้วหน้ากระตุก (CLS) */}
        <div class="col-span-2 flex items-center justify-center py-4">
          <img
            src={p.images[0].src}
            alt={p.images[0].alt}
            width={p.images[0].width}
            height={p.images[0].height}
            fetchpriority="high"
            decoding="async"
            class="w-full max-w-sm object-contain"
          />
        </div>
        {
          p.images.length > 1 && (
            <div class="col-span-2 flex items-end justify-center sm:col-span-1">
              {/* จัดชิดล่าง — รูปแก้วสูงไม่เท่ากันแต่ละขนาด ถ้าจัดกลางก้นแก้วจะลอยไม่ตรงกับบล็อกเขียวข้าง ๆ */}
              <img
                src={p.images[1].src}
                alt={p.images[1].alt}
                width={p.images[1].width}
                height={p.images[1].height}
                loading="lazy"
                decoding="async"
                class="max-h-72 w-auto object-contain"
              />
            </div>
          )
        }
        <!-- บล็อกตัวเลขขนาดแทนรูปที่ 3 — ย้ำจุดที่ลูกค้าใช้เลือกสินค้า -->
        <div
          class="col-span-2 flex flex-col justify-center bg-forest-800 p-6 text-cream-100 sm:col-span-1"
          style="border-radius: var(--radius-sharp)"
        >
          <p class="index-num text-6xl text-cream-50">
            {p.size}<span class="ml-1.5 font-sans text-lg font-medium text-cane-300">มม.</span>
          </p>
          <p class="tabular mt-2 text-sm text-cream-200/75">เส้นผ่านศูนย์กลาง × ยาว 210 มม.</p>
        </div>
      </div>

      <div>
        {
          p.note && (
            <p
              class="border-l-2 border-cane-500 bg-cream-100 px-5 py-4 text-sm text-forest-900"
              style="border-radius: 0 var(--radius-sharp) var(--radius-sharp) 0"
            >
              {p.note}
            </p>
          )
        }

        <h2 class="mt-8 text-xl font-medium text-forest-900">เหมาะกับเมนู</h2>
        <ul class="mt-4 divide-y divide-forest-200/70 border-y border-forest-200/70">
          {
            p.drinks.map((d) => (
              <li class="py-3 text-forest-900">{d}</li>
            ))
          }
        </ul>

        <h2 class="mt-10 text-xl font-medium text-forest-900">ข้อมูลจำเพาะ</h2>
        <dl class="mt-4 divide-y divide-forest-200/70 border-y border-forest-200/70">
          {
            specs.map((s) => (
              <div class="grid gap-1 py-3.5 sm:grid-cols-[10rem_1fr] sm:gap-4">
                <dt class="text-sm text-forest-600">{s.label}</dt>
                <dd class="font-medium text-forest-900">{s.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>

    <!-- บรรจุภัณฑ์ -->
    <section class="border-y border-forest-200/60 bg-cream-100" aria-labelledby="packing">
      <div class="mx-auto max-w-6xl px-4 py-16">
        <p class="eyebrow">ขายส่ง</p>
        <h2 id="packing" class="mt-3 text-2xl font-medium text-forest-900">
          ขนาดบรรจุขายส่ง
        </h2>

        <div class="mt-7 overflow-x-auto">
          <table class="tabular w-full min-w-[480px] border-collapse text-left">
            <caption class="sr-only">ตารางขนาดบรรจุของหลอดชานอ้อย {p.shortName}</caption>
            <thead>
              <tr>
                <th scope="col" class="pb-3 text-[0.7rem] tracking-[0.14em] text-forest-600 uppercase">
                  รูปแบบ
                </th>
                <th scope="col" class="px-4 pb-3 text-right text-[0.7rem] tracking-[0.14em] text-forest-600 uppercase">
                  จำนวนต่อกล่อง
                </th>
                <th scope="col" class="px-4 pb-3 text-right text-[0.7rem] tracking-[0.14em] text-forest-600 uppercase">
                  รายละเอียด
                </th>
              </tr>
            </thead>
            <tbody>
              {
                p.packing.map((box) => (
                  <tr class="border-t border-forest-200/70">
                    <th scope="row" class="py-4 pr-4 text-left font-medium text-forest-900">
                      {box.label}
                    </th>
                    <td class="px-4 py-4 text-right font-semibold text-forest-900">
                      {box.pieces.toLocaleString('th-TH')} ชิ้น
                    </td>
                    <td class="px-4 py-4 text-right text-forest-700/85">
                      {box.packs} แพค × {box.perPack} ชิ้น
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="mt-5 text-sm text-forest-700/75">
          ต้องการจำนวนมากกว่านี้หรือสั่งประจำทุกเดือน ติดต่อขอใบเสนอราคาพิเศษได้
        </p>
      </div>
    </section>

    <!-- ใบรับรอง -->
    <section class="mx-auto max-w-6xl px-4 py-16" aria-labelledby="p-certs">
      <p class="eyebrow">มาตรฐาน</p>
      <h2 id="p-certs" class="mt-3 text-2xl font-medium text-forest-900">
        มาตรฐานที่ผ่านการรับรอง
      </h2>
      <ul class="mt-7 flex flex-wrap gap-x-8 gap-y-3">
        {
          CERTIFICATIONS.map((c) => (
            <li class="border-b border-forest-200 pb-1.5 text-sm font-medium text-forest-800">
              {c.name}
            </li>
          ))
        }
      </ul>
      <p class="mt-8">
        <a
          href="/certifications/"
          class="border-b-2 border-cane-500 pb-1 font-semibold text-forest-800 hover:border-forest-800"
        >
          ดูรายละเอียดใบรับรองแต่ละใบ
        </a>
      </p>
    </section>
  </article>

  <!-- ขนาดอื่น -->
  <section class="border-t border-forest-200/60 bg-cream-100" aria-labelledby="others">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <h2 id="others" class="text-2xl font-medium text-forest-900">
        ขนาดอื่นที่มีจำหน่าย
      </h2>
      <div class="mt-7 grid gap-6 sm:grid-cols-2">
        {
          others.map((o) => (
            <a
              href={`/products/${o.slug}/`}
              class="group flex items-center gap-5 border border-forest-200/70 bg-cream-50 p-5 transition hover:border-forest-400"
              style="border-radius: var(--radius-sharp)"
            >
              <span class="index-num shrink-0 text-4xl text-cane-500" aria-hidden="true">
                {o.size}
              </span>
              <span>
                <span class="block text-lg font-medium text-forest-900">
                  หลอดชานอ้อย {o.shortName}
                </span>
                <span class="mt-1 block text-sm text-forest-700/85">{o.useCase}</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
