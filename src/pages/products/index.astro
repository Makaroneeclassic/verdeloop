---
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import PageHead from '../../components/PageHead.astro';
import { PRODUCTS, SITE } from '../../data/products';

const title = 'หลอดชานอ้อยทุกขนาด 6, 8, 12 มม. ราคาส่ง';
const description =
  'หลอดชานอ้อย Verdeloop มี 3 ขนาด 6 มม. สำหรับเครื่องดื่มทั่วไป 8 มม. สำหรับเมนูปั่น และ 12 มม. สำหรับชานมไข่มุก ทุกขนาดยาว 210 มม. ห่อซองกระดาษ ย่อยสลายได้เอง 100%';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'หน้าแรก', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'สินค้า', item: `${SITE.url}/products/` },
  ],
};
---

<Base {title} {description} {schema}>
  <PageHead
    eyebrow="สินค้า"
    heading="หลอดชานอ้อยทุกขนาด"
    intro="ทุกขนาดยาว 210 มม. ห่อซองกระดาษรายชิ้น ผ่านมาตรฐาน TUV Home Compost เลือกเส้นผ่านศูนย์กลางให้เหมาะกับความข้นของเครื่องดื่มและท็อปปิ้งที่ใส่"
    crumbs={[{ label: 'หน้าแรก', href: '/' }, { label: 'สินค้า' }]}
  />

  <section class="mx-auto max-w-6xl px-4 py-16">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {PRODUCTS.map((p) => <ProductCard product={p} />)}
    </div>
  </section>

  <section class="border-t border-forest-200/60 bg-cream-100" aria-labelledby="pick">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <p class="eyebrow">คู่มือเลือกซื้อ</p>
      <h2 id="pick" class="mt-3 text-2xl font-medium text-forest-900">
        เลือกขนาดยังไงให้ถูก
      </h2>
      <p class="mt-3 max-w-2xl text-forest-800/80">
        หลักง่าย ๆ คือดูจากสิ่งที่ต้องดูดผ่านหลอด ยิ่งมีท็อปปิ้งชิ้นใหญ่ ยิ่งต้องใช้ปากกว้าง
      </p>

      <div class="mt-8 overflow-x-auto">
        <table class="tabular w-full min-w-[560px] border-collapse text-left">
          <caption class="sr-only">ตารางเปรียบเทียบขนาดหลอดชานอ้อยและการใช้งาน</caption>
          <thead>
            <tr>
              <th scope="col" class="pb-3 text-[0.7rem] tracking-[0.14em] text-forest-600 uppercase">
                ขนาด
              </th>
              <th scope="col" class="px-4 pb-3 text-[0.7rem] tracking-[0.14em] text-forest-600 uppercase">
                เหมาะกับ
              </th>
              <th scope="col" class="px-4 pb-3 text-right text-[0.7rem] tracking-[0.14em] text-forest-600 uppercase">
                CO₂e ต่อหลอด
              </th>
            </tr>
          </thead>
          <tbody>
            {
              PRODUCTS.map((p) => (
                <tr class="border-t border-forest-200/70">
                  <th scope="row" class="py-4 pr-4 text-left font-medium text-forest-900">
                    <a href={`/products/${p.slug}/`} class="hover:underline">
                      {p.dimensions}
                    </a>
                  </th>
                  <td class="px-4 py-4 text-forest-800/85">{p.drinks.join(' · ')}</td>
                  <td class="px-4 py-4 text-right font-semibold text-forest-900">
                    {p.co2PerStraw} ก.
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
