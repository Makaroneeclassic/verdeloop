---
import LineButton from '../components/LineButton.astro';
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import CtaBand from '../components/CtaBand.astro';
import LeadRequest from '../components/LeadRequest.astro';
import Mark from '../components/Mark.astro';
import { CERTIFICATIONS, CONTACT, PRODUCTS } from '../data/products';

const title = 'หลอดชานอ้อย ราคาส่ง หลอดรักษ์โลกสำหรับร้านกาแฟ | Verdeloop';
const description =
  'หลอดชานอ้อย Verdeloop ทางเลือกหลอดรักษ์โลกสำหรับร้านกาแฟ โรงแรม และองค์กร มีขนาด 6, 8, 12 มม. ห่อซองกระดาษ ดูใบรับรอง เลือกขนาด และขอตัวอย่างพร้อมราคาส่ง';

const featuredCerts = CERTIFICATIONS.filter((c) => c.featured);

// เหตุผลที่ลูกค้าเลือก เรียงตามน้ำหนักในการตัดสินใจจริง
// เขียนเป็นลิสต์มีเลขกำกับ ไม่ใช่การ์ด 4 ใบเท่ากัน — ให้อ่านไล่ลงมาตามลำดับความสำคัญ
const reasons = [
  {
    title: 'แช่ทั้งแก้วก็ไม่เปื่อย',
    body: 'ปัญหาที่ทุกร้านเจอกับหลอดกระดาษคือดูดไปครึ่งแก้วแล้วหลอดยุ่ย ลูกค้าบ่น หลอดชานอ้อยขึ้นรูปจากเส้นใยพืชทั้งเส้น ไม่ใช่กระดาษม้วนทากาว จึงคงรูปได้ตลอดการดื่ม',
  },
  {
    title: 'ทิ้งรวมขยะเปียกได้เลย',
    body: 'ผ่านมาตรฐาน Home Compost ของ TUV Austria ย่อยสลายเองได้ในสภาพแวดล้อมทั่วไป ไม่ต้องคัดแยกส่งโรงงานอุตสาหกรรมเหมือนหลอด PLA',
  },
  {
    title: 'ไม่ทิ้งกลิ่นรบกวนรสชาติ',
    body: 'มีกลิ่นใยพืชจาง ๆ ตามธรรมชาติ ไม่มีรสกระดาษเปียกหรือกลิ่นพลาสติกมากวนรสเครื่องดื่ม',
  },
  {
    title: 'มีตัวเลขคาร์บอนให้ใช้จริง',
    body: 'ผ่านการตรวจวัด ISO 14067 ทุกขนาด นำตัวเลขไปใส่รายงานความยั่งยืนขององค์กรได้โดยตรง ไม่ต้องประมาณเอง',
  },
];

// ตารางเทียบย่อบนหน้าแรก — ฉบับเต็มอยู่หน้า /compare/
const comparison = [
  { feature: 'แช่เครื่องดื่มได้นาน', cane: true, paper: false, pla: true },
  { feature: 'ย่อยสลายเองที่บ้านได้', cane: true, paper: true, pla: false },
  { feature: 'ไม่ทิ้งรสชาติแปลกปลอม', cane: true, paper: false, pla: true },
  { feature: 'ทิ้งรวมเศษอาหารได้', cane: true, paper: true, pla: false },
  { feature: 'ผลิตจากวัสดุเหลือใช้ทางเกษตร', cane: true, paper: false, pla: false },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Verdeloop',
    url: 'https://verdeloopthailand.com',
    inLanguage: 'th-TH',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'หลอดชานอ้อย Verdeloop',
    itemListElement: PRODUCTS.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: p.name,
      url: `https://verdeloopthailand.com/products/${p.slug}/`,
    })),
  },
];
---

<Base
  {title}
  {description}
  {schema}
  preload={{
    src: '/img/hero-straws.webp',
    srcset: '/img/hero-straws.webp 448w, /img/hero-straws@2x.webp 896w',
    sizes: '(min-width: 1024px) 16rem, (min-width: 640px) 12rem, 10rem',
  }}
>
  <!-- HERO — กลับมาใช้แบบเดิมตามที่เจ้าของเลือก: พื้นไล่สีอ่อน ป้ายกลม ปุ่มมนเต็ม -->
  <section class="border-b border-forest-100 bg-gradient-to-b from-forest-50 to-cream-50">
    <div class="mx-auto grid max-w-6xl items-center gap-8 px-5 py-10 sm:px-6 sm:py-12 lg:grid-cols-[1.15fr_0.85fr] lg:gap-12 lg:py-16">
      <div class="min-w-0">
        <p
          class="inline-flex items-center gap-2 rounded-full bg-forest-100 px-3 py-1.5 text-[0.65rem] font-semibold text-forest-700 sm:text-xs"
        >
          <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-forest-500"></span>
          รับรอง TUV Austria — Home Compost
        </p>
        <!-- หัวข้อ hero — หนากว่าหัวข้ออื่นในเว็บ (700 vs 500/600) เพราะเป็นจุดแรกที่ตาไปตก -->
        <h1
          class="mt-5 text-[clamp(1.75rem,4vw,3rem)] leading-snug font-bold text-balance text-forest-900"
        >
          หลอดกระดาษเปื่อยยุ่ย<br />
          <span class="text-forest-600">หลอดชานอ้อยไม่เป็น</span>
        </h1>
        <p class="mt-4 max-w-xl text-base text-pretty text-forest-800/85 sm:text-lg">
          หลอดชานอ้อย ทางเลือกหลอดรักษ์โลกสำหรับร้านเครื่องดื่ม แช่ได้ตลอดแก้วโดยไม่ยุ่ย
          ย่อยสลายเองได้ในธรรมชาติ 100% ทิ้งรวมกับเศษอาหารได้เลย
          มี 3 ขนาดสำหรับทุกเมนู ตั้งแต่กาแฟเย็นถึงชานมไข่มุก
        </p>
        <div class="action-group mt-6">
          <a
            href="#request"
            class="rounded-full bg-forest-700 px-6 py-3 font-semibold text-cream-50 transition hover:bg-forest-800"
          >
            ขอตัวอย่างฟรี
          </a>
          <a
            href="/products/"
            class="rounded-full px-6 py-3 font-semibold text-forest-800 ring-1 ring-forest-300 transition hover:bg-forest-50"
          >
            เลือกขนาดหลอด
          </a>
          <LineButton placement="hero">สอบถามราคาทาง LINE</LineButton>
        </div>

      </div>

      <!-- ลบพื้นขาวออกแล้ว หลอดจึงลอยอยู่บนพื้นไล่สีของ hero ไม่มีกรอบสี่เหลี่ยม
           ก้นแก้วในรูปต้นฉบับถูกตัดขาด จึงเฟดขอบล่างให้จางหายแทนการตัดตรง
           เสิร์ฟจากเครื่องเราเอง ไม่ดึงจาก 2amplus.com — โดเมนคนอื่นช้ากว่าและถ้าเขาลบรูปเว็บเราพัง
           รูปนี้คือ LCP ของหน้าแรก จึงใส่ fetchpriority="high" และไม่ lazy -->
      <div class="relative">
        <img
          src="/img/hero-straws.webp"
          srcset="/img/hero-straws.webp 448w, /img/hero-straws@2x.webp 896w"
          sizes="(min-width: 1024px) 16rem, (min-width: 640px) 12rem, 10rem"
          alt="หลอดชานอ้อย Verdeloop หลายเส้นแช่อยู่ในแก้วน้ำใส คงรูปไม่เปื่อยยุ่ย"
          width="448"
          height="888"
          fetchpriority="high"
          decoding="async"
          class="mx-auto h-72 w-auto max-w-full object-contain sm:h-96 lg:h-[30rem]"
        />
      </div>
    </div>
  </section>

  <!-- แถบตัวเลขจริง — ย้ายลงมาเป็นแถบแยกใต้ hero
       ฝ่ายจัดซื้อได้ข้อมูลตัดสินใจเร็วโดยไม่ต้องรบกวนหน้าตา hero -->
  <section class="border-b border-forest-100 bg-cream-100" aria-label="ข้อมูลสินค้าโดยสรุป">
    <dl class="tabular mx-auto grid max-w-6xl grid-cols-2 gap-x-6 gap-y-7 px-5 sm:px-6 py-8 lg:grid-cols-4">
      <div>
        <dt class="text-[0.7rem] tracking-[0.14em] text-forest-600 uppercase">ขนาดที่มี</dt>
        <dd class="mt-1.5 text-xl font-semibold text-forest-900">6 · 8 · 12 มม.</dd>
      </div>
      <div>
        <dt class="text-[0.7rem] tracking-[0.14em] text-forest-600 uppercase">ความยาวมาตรฐาน</dt>
        <dd class="mt-1.5 text-xl font-semibold text-forest-900">210 มม.</dd>
      </div>
      <div>
        <dt class="text-[0.7rem] tracking-[0.14em] text-forest-600 uppercase">ใบรับรอง</dt>
        <dd class="mt-1.5 text-xl font-semibold text-forest-900">{CERTIFICATIONS.length} รายการ</dd>
      </div>
      <div>
        <dt class="text-[0.7rem] tracking-[0.14em] text-forest-600 uppercase">คาร์บอนต่อหลอด</dt>
        <dd class="mt-1.5 text-xl font-semibold text-forest-900">เริ่ม 3.93 ก.</dd>
      </div>
    </dl>
  </section>

  <!-- เหตุผลที่เลือก — ลิสต์มีเลขกำกับ หัวข้ออยู่ซ้าย เนื้อหาอยู่ขวา
       ต่างจากการ์ดกริดตรงที่อ่านไล่ลำดับได้ และหัวข้อไม่ลอยกลางหน้า -->
  <section class="mx-auto max-w-6xl px-5 sm:px-6 section-space" aria-labelledby="why">
    <div class="grid gap-10 lg:grid-cols-[22rem_1fr] lg:gap-16">
      <div class="lg:sticky lg:top-28 lg:self-start">
        <p class="eyebrow">เหตุผลที่ร้านเปลี่ยนมาใช้</p>
        <h2 id="why" class="mt-3 text-2xl leading-snug font-medium text-forest-900 sm:text-3xl">
          หลอดชานอ้อย ทางเลือกหลอดรักษ์โลกสำหรับร้านเครื่องดื่ม
        </h2>
        <div class="tick-rule mt-6 max-w-[12rem] text-forest-700"></div>
      </div>

      <ol class="space-y-9">
        {
          reasons.map((r, i) => (
            <li class="grid grid-cols-[3rem_1fr] gap-x-5 border-b border-forest-100 pb-9 last:border-0 last:pb-0">
              <span class="index-num pt-1 text-2xl text-cane-500" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div>
                <h3 class="text-xl font-medium text-forest-900">{r.title}</h3>
                <p class="mt-2.5 text-forest-800/85">{r.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 3 ขนาด -->
  <section class="border-y border-forest-200/60 bg-cream-100" aria-labelledby="sizes">
    <div class="mx-auto max-w-6xl px-5 sm:px-6 section-space">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="eyebrow">สินค้า</p>
          <h2 id="sizes" class="mt-3 text-2xl font-medium text-forest-900 sm:text-3xl">
            เลือกขนาดให้ตรงกับเมนูของร้าน
          </h2>
          <p class="mt-3 max-w-xl text-forest-800/80">
            ทุกขนาดยาว 210 มม. ห่อซองกระดาษรายชิ้น สะอาดถูกสุขอนามัย พร้อมเสิร์ฟ
          </p>
        </div>
        <a
          href="/products/"
          class="border-b-2 border-cane-500 pb-1 text-sm font-semibold text-forest-800 hover:border-forest-800"
        >
          ดูสินค้าทั้งหมด
        </a>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {PRODUCTS.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  <!-- ตารางเทียบย่อ -->
  <section class="mx-auto max-w-6xl px-5 sm:px-6 section-space" aria-labelledby="compare">
    <div class="max-w-2xl">
      <p class="eyebrow">เปรียบเทียบ</p>
      <h2 id="compare" class="mt-3 text-2xl font-medium text-forest-900 sm:text-3xl">
        เลือกหลอดรักษ์โลก: เปรียบเทียบหลอดชานอ้อย หลอดกระดาษ และ PLA
      </h2>
      <p class="mt-3 text-forest-800/80">
        หากคุณกำลังมองหาหลอดกระดาษรักษ์โลก ลองเปรียบเทียบวัสดุ ความคงรูปขณะแช่เครื่องดื่ม และเงื่อนไขการย่อยสลายก่อนเลือกใช้
        Verdeloop จำหน่ายหลอดชานอ้อย เป็นอีกทางเลือกสำหรับร้านที่ต้องการเปลี่ยนจากหลอดกระดาษ
      </p>
    </div>

    <div class="relative mt-7 overflow-hidden rounded-2xl">
      <table class="tabular w-full table-fixed border-collapse text-left text-xs sm:text-base">
        <caption class="sr-only">
          ตารางเปรียบเทียบคุณสมบัติหลอดชานอ้อย หลอดกระดาษ และหลอด PLA
        </caption>
        <thead>
          <tr>
            <th scope="col" class="w-[40%] pb-3 text-[0.7rem] tracking-[0.14em] text-forest-600 uppercase">
              คุณสมบัติ
            </th>
            <th
              scope="col"
              class="bg-forest-800 px-2 py-3 text-center text-xs font-semibold text-cream-50 sm:px-4 sm:text-sm"
            >
              ชานอ้อย
            </th>
            <th scope="col" class="px-2 pb-3 text-center text-[0.7rem] text-forest-600 sm:px-4">
              กระดาษ
            </th>
            <th scope="col" class="px-2 pb-3 text-center text-[0.7rem] text-forest-600 sm:px-4">
              PLA
            </th>
          </tr>
        </thead>
        <tbody>
          {
            comparison.map((row) => (
              <tr class="border-t border-forest-200/70">
                <th scope="row" class="py-4 pr-3 text-left font-normal text-forest-900 sm:pr-6">
                  {row.feature}
                </th>
                <td class="bg-forest-50 px-2 py-4 text-center sm:px-4">
                  <Mark yes={row.cane} label={row.cane ? 'ใช่' : 'ไม่ใช่'} />
                </td>
                <td class="px-2 py-4 text-center sm:px-4">
                  <Mark yes={row.paper} label={row.paper ? 'ใช่' : 'ไม่ใช่'} />
                </td>
                <td class="px-2 py-4 text-center sm:px-4">
                  <Mark yes={row.pla} label={row.pla ? 'ใช่' : 'ไม่ใช่'} />
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="mt-8">
      <a
        href="/compare/"
        class="border-b-2 border-cane-500 pb-1 font-semibold text-forest-800 hover:border-forest-800"
      >
        อ่านฉบับเต็ม รวมถึงความต่างของ Home Compost กับ Industrial Compost
      </a>
    </p>
  </section>

  <!-- ใบรับรอง — วางเป็นแถวยาวมีเส้นคั่น ไม่ใช่การ์ด 3 ใบ -->
  <section class="border-t border-forest-200/60 bg-cream-100" aria-labelledby="certs">
    <div class="mx-auto max-w-6xl px-5 sm:px-6 section-space">
      <div class="max-w-2xl">
        <p class="eyebrow">มาตรฐาน</p>
        <h2 id="certs" class="mt-3 text-2xl font-medium text-forest-900 sm:text-3xl">
          ผ่านมาตรฐานสากล ใช้อ้างอิงกับฝ่ายจัดซื้อได้
        </h2>
      </div>

      <dl class="mt-10 divide-y divide-forest-200/70 border-y border-forest-200/70">
        {
          featuredCerts.map((c) => (
            <div class="grid grid-cols-[4.5rem_1fr] items-center gap-x-5 gap-y-2 py-6 md:grid-cols-[7rem_15rem_1fr] md:gap-8">
              {/* โลโก้มาก่อนชื่อ — ฝ่ายจัดซื้อกวาดตาหาเครื่องหมายที่คุ้นตาเร็วกว่าอ่านชื่อ
                  พื้นขาวรองไว้ เพราะเครื่องหมายรับรองออกแบบมาให้อยู่บนพื้นขาว */}
              {c.logo ? (
                <img
                  src={c.logo.src}
                  alt={`เครื่องหมายรับรอง ${c.name}`}
                  width={c.logo.width}
                  height={c.logo.height}
                  loading="lazy"
                  decoding="async"
                  class="row-span-2 h-14 w-full rounded-xl bg-white object-contain p-2 ring-1 ring-forest-200/70 md:row-span-1"
                />
              ) : (
                <span class="row-span-2 md:row-span-1" />
              )}
              <dt class="text-base font-medium text-forest-900 sm:text-lg">{c.name}</dt>
              <dd class="col-start-2 text-sm text-forest-800/85 md:col-start-3 md:text-base">{c.detail}</dd>
            </div>
          ))
        }
      </dl>

      <p class="mt-8">
        <a
          href="/certifications/"
          class="border-b-2 border-cane-500 pb-1 font-semibold text-forest-800 hover:border-forest-800"
        >
          ดูใบรับรองทั้งหมด {CERTIFICATIONS.length} รายการ
        </a>
      </p>
    </div>
  </section>

  <LeadRequest />
  <CtaBand />
</Base>
