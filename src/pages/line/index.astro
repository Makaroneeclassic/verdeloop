---
import Base from '../../layouts/Base.astro';
import {CONTACT} from '../../data/products';
---
<Base title="ติดต่อผ่าน LINE" description="ติดต่อทีมงาน Verdeloop ผ่าน LINE" noindex>
 <section class="mx-auto max-w-xl px-5 py-16 sm:py-24">
  <p class="eyebrow">LINE @verdeloop</p>
  <h1 class="mt-3 text-3xl font-medium">คุยกับทีมงาน Verdeloop</h1>
  <p id="line-status" role="status" class="my-6 leading-relaxed text-forest-700">กำลังเปิด LINE…</p>
  <button id="line-debug-test" type="button" hidden class="mb-6 rounded-full border border-forest-700 px-6 py-3">ทดสอบส่ง Conversion คลิก LINE</button>
  <a id="line-chat" href={CONTACT.lineUrl} target="_blank" rel="noopener noreferrer" class="line-button"><img src="/img/line-brand.png" width="40" height="40" alt="" aria-hidden="true" class="line-button-icon" /><span>เปิด LINE เพื่อแชต</span></a>
  <p class="mt-6 text-sm text-forest-700">สอบถามขนาด ขอราคาส่ง หรือขอตัวอย่างได้เลยครับ</p>
  <p class="mt-3 text-sm"><a href="/privacy/" class="underline">นโยบายความเป็นส่วนตัว</a> · <a href="/sugarcane-straw/" class="underline">กลับดูสินค้า</a></p>
  <noscript><p class="mt-4">กดปุ่มด้านบนเพื่อเปิด LINE</p></noscript>
 </section>
 <script is:inline src="/js/line-contact.js?v=3" defer></script>
</Base>
