---
import Base from '../layouts/Base.astro';
---
<Base title="VERDELOOP_ARTICLE_TITLE_TOKEN" description="VERDELOOP_ARTICLE_DESCRIPTION_TOKEN">
 <div class="articles-shell"><Fragment set:html={'VERDELOOP_ARTICLE_BODY_TOKEN'} /></div>
</Base>
<style is:global>
.articles-shell{max-width:1120px;margin:auto;padding:44px 24px 72px;color:#19372c}
.articles-shell h1{font-size:clamp(1.9rem,4vw,3.2rem);font-weight:600;line-height:1.5;margin:18px 0;overflow-wrap:anywhere}
.articles-shell .article-intro{color:#52695b;font-size:1.1rem;line-height:1.85;margin:16px 0 26px}
.articles-shell .article-body{max-width:780px;margin:36px auto;line-height:1.95;overflow-wrap:anywhere}
.article-body h2{font-size:1.65rem;font-weight:600;margin:2rem 0 1rem}.article-body h3{font-size:1.3rem;font-weight:600;margin:1.5rem 0 .8rem}
.article-body p,.article-body ul,.article-body ol,.article-body figure{margin:1rem 0}.article-body ul{list-style:disc;padding-left:1.5rem}.article-body ol{list-style:decimal;padding-left:1.5rem}
.article-body a,.article-breadcrumb a{text-decoration:underline;text-underline-offset:4px}.article-body blockquote{border-left:3px solid #b8985b;padding-left:20px;margin:20px 0}
.article-body img,.article-cover{width:100%;height:auto;border-radius:24px}.article-cover{max-height:640px;object-fit:cover}.article-body table{display:block;overflow:auto;border-collapse:collapse}.article-body th,.article-body td{padding:12px;border:1px solid #cedbcf}
.article-line{margin-top:32px}.article-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.article-card{border:1px solid #d5e0d5;border-radius:24px;overflow:hidden;background:#fffdf8}.article-card img{width:100%;aspect-ratio:16/9;object-fit:cover}.article-card-body{padding:24px}.article-card h2{font-size:1.35rem;font-weight:600;line-height:1.6;margin-bottom:12px}.article-card p{line-height:1.8;color:#52695b}.article-date{color:#63766a;font-size:.9rem;margin:12px 0}.article-breadcrumb{color:#52695b}.article-pages{display:flex;gap:24px;justify-content:center;margin-top:30px}.article-pages a{text-decoration:underline}
@media(max-width:800px){.article-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:540px){.article-grid{grid-template-columns:1fr}.articles-shell{padding:28px 18px 48px}.article-body h2{font-size:1.4rem}.article-body img,.article-cover{border-radius:18px}}
</style>
