---
import LineButton from './LineButton.astro';
import { CONTACT } from '../data/products';

// ต้องตรงกับรายการที่ api/lead.js ตรวจสอบ — ถ้าแก้ที่นี่ต้องแก้ที่นั่นด้วย
const BUSINESS_TYPES = [
  'ร้านกาแฟ / คาเฟ่',
  'ร้านชานมไข่มุก',
  'ร้านอาหาร',
  'โรงแรม / รีสอร์ท',
  'โรงงาน / ผู้ผลิต',
  'ตัวแทนจำหน่าย',
  'องค์กร / หน่วยงาน',
  'อื่น ๆ',
];
const SIZES = ['6 มม.', '8 มม.', '12 มม.', 'ยังไม่แน่ใจ'];
const VOLUMES = [
  'น้อยกว่า 5,000 ชิ้น',
  '5,000–20,000 ชิ้น',
  '20,000–50,000 ชิ้น',
  'มากกว่า 50,000 ชิ้น',
  'ยังไม่แน่ใจ',
];

// คลาสร่วมของช่องกรอก — ประกาศครั้งเดียวกันหลุด
const field =
  'mt-1.5 w-full border border-forest-300 bg-cream-50 px-3.5 py-2.5 text-forest-900 outline-none transition focus:border-forest-600 focus:ring-2 focus:ring-forest-600/20';
const label = 'block text-sm font-medium text-forest-900';
---

  <div class="mx-auto grid max-w-6xl gap-7 px-5 py-9 sm:px-6 sm:py-14 lg:grid-cols-[1fr_20rem] lg:gap-16">
    <!-- ฟอร์ม -->
    <div id="request" class="scroll-mt-24">
      <p class="eyebrow">เริ่มต้นได้ที่นี่</p>
      <h2 class="mt-3 text-3xl font-medium">ขอตัวอย่างฟรี หรือขอใบเสนอราคา</h2>
      <p class="mb-4 mt-3 text-forest-700">กรอกชื่อและเบอร์โทร ทีมงานจะติดต่อกลับภายในวันทำการเพื่อยืนยันความต้องการ</p>
      <p class="mb-6 rounded-2xl bg-forest-50 px-4 py-3 text-sm font-medium text-forest-800">ตัวอย่างฟรี รวมค่าส่ง · จัดส่ง 3–7 วัน</p>
      <p class="mb-6 flex flex-wrap items-center gap-3 text-sm text-forest-700">สะดวกคุยแชต? <LineButton placement="form">ทัก LINE</LineButton></p>
      <!-- แบนเนอร์แจ้ง error — ซ่อนไว้ก่อน สคริปต์ท้ายหน้าเปิดตาม ?error= ที่ API เด้งกลับมา
           หน้านี้เป็น static จึงอ่าน query string ตอน build ไม่ได้ ต้องอ่านฝั่งเบราว์เซอร์ -->
      <div
        id="err-delivery"
        role="alert"
        hidden
        class="mb-8 rounded-2xl border border-red-200 bg-red-50 px-5 py-4 text-sm text-red-900"
      >
        <p class="font-semibold">ส่งฟอร์มไม่สำเร็จ</p>
        {/* กล่องนี้โผล่ตอนฟอร์มพัง = ลีดกำลังจะหลุด ต้องมีช่องทางสำรองเสมอ ห้ามว่าง */}
        <p class="mt-1">
          ระบบขัดข้องชั่วคราว กรุณาลองใหม่ หรือใช้ปุ่ม “ทัก LINE” ด้านบนเพื่อติดต่อทีมงาน
        </p>
      </div>

      <div
        id="err-validation"
        role="alert"
        hidden
        class="mb-8 rounded-2xl border border-red-200 bg-red-50 px-5 py-4 text-sm text-red-900"
      >
        <p class="font-semibold">กรอกข้อมูลไม่ครบ</p>
        <p class="mt-1">กรุณาตรวจสอบช่องที่ทำเครื่องหมายไว้ด้านล่าง</p>
      </div>

      <form id="form" method="POST" action="/api/lead" class="space-y-6">
        <!-- honeypot: คนจริงมองไม่เห็น บอทกรอกทุกช่อง ใช้จับบอทโดยไม่ต้องให้คนแก้ captcha
             ใช้ตำแหน่ง absolute ไม่ใช่ display:none เพราะบอทบางตัวข้ามช่องที่ซ่อนแบบนั้น -->
        <div class="absolute left-[-9999px]" aria-hidden="true">
          <label for="website">เว็บไซต์ (ไม่ต้องกรอก)</label>
          <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="name" class={label}>
              ชื่อผู้ติดต่อ <span class="text-red-600" aria-hidden="true">*</span>
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              autocomplete="name"
              class={field}
              style="border-radius: var(--radius-control)"
            />
          </div>

          <div>
            <label for="phone" class={label}>
              เบอร์โทร <span class="text-red-600" aria-hidden="true">*</span>
            </label>
            <input
              type="tel"
              id="phone"
              name="phone"
              required
              inputmode="tel"
              autocomplete="tel"
              placeholder="08X-XXX-XXXX หรือ +66 8X XXX XXXX"
              maxlength="100"
              aria-describedby="phone-hint"
              class={field}
              style="border-radius: var(--radius-control)"
            />
            <p id="phone-hint" class="mt-1.5 text-xs text-forest-600">
              ใส่ได้ทั้ง 0 หรือ +66 เว้นวรรคหรือใส่ขีดได้
            </p>
          </div>

          <div>
            <label for="size" class={label}>ขนาดที่สนใจ</label>
            <select id="size" name="size" class={field} style="border-radius: var(--radius-control)">
              <option value="">เลือกขนาด</option>
              {SIZES.map((s) => <option value={s}>{s}</option>)}
            </select>
          </div>

        </div>
        <details class="rounded-2xl border border-forest-200 p-4">
          <summary class="cursor-pointer font-medium">เพิ่มข้อมูลร้านและรายละเอียดที่ต้องการ (ไม่บังคับ)</summary>
          <div class="mt-5 grid gap-5 sm:grid-cols-2">
          <div>
            <label for="company" class={label}>ชื่อร้าน / บริษัท</label>
            <input
              type="text"
              id="company"
              name="company"
              autocomplete="organization"
              class={field}
              style="border-radius: var(--radius-control)"
            />
          </div>

          <div>
            <label for="email" class={label}>อีเมล</label>
            <input
              type="email"
              id="email"
              name="email"
              autocomplete="email"
              aria-describedby="email-hint"
              class={field}
              style="border-radius: var(--radius-control)"
            />
            <p id="email-hint" class="mt-1.5 text-xs text-forest-600">
              ใส่ไว้ถ้าต้องการรับใบเสนอราคาทางอีเมล
            </p>
          </div>

          <div>
            <label for="businessType" class={label}>ประเภทธุรกิจ</label>
            <select
              id="businessType"
              name="businessType"
              class={field}
              style="border-radius: var(--radius-control)"
            >
              <option value="">เลือกประเภท</option>
              {BUSINESS_TYPES.map((t) => <option value={t}>{t}</option>)}
            </select>
          </div>

          <div class="sm:col-span-2">
            <label for="volume" class={label}>ปริมาณที่ใช้ต่อเดือน (โดยประมาณ)</label>
            <select
              id="volume"
              name="volume"
              class={field}
              style="border-radius: var(--radius-control)"
            >
              <option value="">เลือกปริมาณ</option>
              {VOLUMES.map((v) => <option value={v}>{v}</option>)}
            </select>
          </div>

          <div class="sm:col-span-2">
            <label for="message" class={label}>ข้อความเพิ่มเติม</label>
            <textarea
              id="message"
              name="message"
              rows="4"
              class={field}
              style="border-radius: var(--radius-control)"
              placeholder="เช่น ต้องการไฟล์ใบรับรองสำหรับฝ่ายจัดซื้อ หรือสอบถามเรื่องพิมพ์โลโก้บนซอง"></textarea>
          </div>
          </div>
        </details>

        <!-- การส่งคำขออนุญาตให้ดำเนินการเรื่องสินค้า; การวัดผลเพิ่มเติมเลือกได้ในช่องเดียว -->
        <input type="hidden" name="contactRequest" value="sample-v2" />
        <p class="text-sm text-forest-700">เมื่อส่งคำขอ คุณขอให้ {CONTACT.company} เก็บและใช้ข้อมูลที่กรอกเพื่อติดต่อกลับและดำเนินการเรื่องตัวอย่างสินค้า ตาม <a href="/privacy/" class="font-semibold underline">นโยบายความเป็นส่วนตัว</a></p>
        <div
          class="flex gap-3 border border-forest-200 bg-cream-100 px-4 py-3.5"
          style="border-radius: var(--radius-card)"
        >
          <input
            type="checkbox"
            id="consent-all"
            name="allConsent"
            class="mt-1 h-4 w-4 shrink-0 accent-forest-700"
          />
          <div class="min-w-0 text-sm text-forest-900">
            <label for="consent-all">
              ยินยอมให้ {CONTACT.company} เก็บและใช้ข้อมูลเพื่อติดต่อกลับเรื่องสินค้า
            </label>
            <details class="mt-2 text-forest-700">
              <summary class="cursor-pointer font-semibold underline underline-offset-4">อ่านรายละเอียดความยินยอม การวัดผลและโฆษณา</summary>
              <p class="mt-3">การเลือกช่องนี้รวมถึงการยินยอมวัดการเข้าชมและการกดติดต่อผ่าน Google Analytics เก็บรหัสคลิกและแหล่งที่มาของโฆษณา และส่งผลการส่งฟอร์ม/ผลการขายไป Google Ads เพื่อวัดประสิทธิภาพ ตาม <a href="/privacy/" class="font-semibold underline">นโยบายความเป็นส่วนตัว</a></p>
              <p class="mt-2">ไม่ส่งชื่อ เบอร์โทร หรืออีเมลไป Google · ไม่บังคับเลือกช่องนี้เพื่อขอตัวอย่าง หากไม่เปลี่ยนตัวเลือก จะใช้การตั้งค่าการวัดผลเดิมที่คุณเลือกไว้</p>
            </details>
          </div>
        </div>

        <button
          type="submit"
          class="w-full bg-forest-800 px-8 py-3.5 font-semibold text-cream-50 transition hover:bg-forest-950 sm:w-auto"
          style="border-radius: var(--radius-pill)"
        >
          ส่งคำขอให้ทีมงานติดต่อกลับ
        </button>

      </form>
    </div>

    <!-- ข้างฟอร์ม: ตอบคำถามที่ทำให้คนลังเลก่อนกดส่ง -->
    <aside class="lg:self-start">
      <div
        class="border border-forest-200 bg-cream-100 px-5 py-6"
        style="border-radius: var(--radius-card)"
      >
        <h2 class="text-lg font-medium text-forest-900">ขั้นตอนหลังส่งฟอร์ม</h2>
        <ol class="mt-4 space-y-4">
          {
            [
              'ทีมขายโทรกลับยืนยันที่อยู่จัดส่งภายในวันทำการ',
              'ยืนยันขนาดและจัดทำใบเสนอราคา ตัวอย่างฟรี รวมค่าส่ง',
              'จัดส่ง 3–7 วัน ให้ทดลองกับเครื่องดื่มจริงก่อนตัดสินใจ',
            ].map((s, i) => (
              <li class="grid grid-cols-[1.75rem_1fr] gap-x-3 text-sm text-forest-800">
                <span class="index-num text-base text-cane-500" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span>{s}</span>
              </li>
            ))
          }
        </ol>

      </div>

      <p class="mt-5 border-l-2 border-cane-500 pl-4 text-sm text-forest-800">
        <a href="/documents/" class="font-semibold underline">ดาวน์โหลดสเปกสินค้า</a> สำหรับฝ่ายจัดซื้อ หรือ
        ขอใบรับรองฉบับจริงผ่านปุ่ม “ทัก LINE” ด้านบน
      </p>
    </aside>
  </div>

<script>
 document.getElementById('form')?.addEventListener('invalid',event=>{
  const details=(event.target as HTMLElement).closest('details');if(details)details.open=true;
 },true);
</script>

<!-- อ่าน ?error= ที่ API เด้งกลับมา แล้วเปิดแบนเนอร์ + ไฮไลต์ช่องที่ผิด
     ต้องทำฝั่งเบราว์เซอร์เพราะหน้านี้ static — query string ตอน build ว่างเสมอ -->
<script is:inline>
  (() => {
    const raw = new URLSearchParams(location.search).get('error');
    if (!raw) return;

    if (raw === 'rate_limit') {
      const box=document.getElementById('err-validation');if(box){box.hidden=false;box.querySelector('p').textContent='ส่งข้อมูลหลายครั้งเกินไป';box.querySelector('p.mt-1').textContent='กรุณารอสักครู่แล้วลองใหม่ หรือติดต่อทาง LINE';}return;
    }
    if (raw === 'delivery') {
      document.getElementById('err-delivery')?.removeAttribute('hidden');
      return;
    }

    document.getElementById('err-validation')?.removeAttribute('hidden');

    for (const name of raw.split(',')) {
      const el = document.getElementById(name.trim());
      if (!el) continue;
      const details=el.closest('details');if(details)details.open=true;
      el.setAttribute('aria-invalid', 'true');
      el.classList.add('border-red-500');
    }

    // ล้าง query string ออกจาก URL — กันสับสนตอนผู้ใช้แก้แล้วส่งใหม่
    // และกัน Google Ads นับ URL ที่มี ?error= เป็นหน้าคนละหน้า
    const cleaned=new URL(location.href);cleaned.searchParams.delete('error');
    history.replaceState(null, '', cleaned.pathname + cleaned.search + cleaned.hash);
  })();
</script>
