---
const tips = [
  { title: 'เก็บให้แห้ง พร้อมหยิบใช้', text: 'เก็บที่อุณหภูมิห้อง หลีกเลี่ยงแดด ความร้อน และความชื้น ปิดบรรจุภัณฑ์หลังเปิดใช้ และตรวจวันผลิตกับคำแนะนำบนกล่องของแต่ละล็อต' },
  { title: 'เลือกจากเมนูที่เสิร์ฟจริง', text: '6 มม. สำหรับเครื่องดื่มทั่วไป · 8 มม. สำหรับเมนูปั่น · 12 มม. สำหรับท็อปปิ้ง ลองกับแก้ว ฝาซีล และขนาดไข่มุกของร้านก่อนสั่งจำนวนมาก' },
  { title: 'เริ่มทดลองกับเครื่องดื่มเย็น', text: 'ทดสอบกับเมนูและระยะเวลาที่ลูกค้าใช้จริง สำหรับเครื่องดื่มร้อน ควรยืนยันช่วงอุณหภูมิของรุ่นสินค้ากับทีมงานก่อนใช้งาน' },
];
---

<section class="mx-auto max-w-6xl px-5 sm:px-6 section-space-sm" aria-label="รู้จักวัสดุและการดูแลหลอด">
  <div class="grid items-center gap-8 lg:grid-cols-2 lg:gap-14">
    <figure class="min-w-0">
      <img src="/img/sugarcane-fibers.jpg" alt="ภาพหลอดชานอ้อยโทนธรรมชาติในแก้วใส วางคู่กับท่อนอ้อย" width="800" height="533" loading="lazy" decoding="async" class="aspect-[3/2] w-full object-cover" style="border-radius: var(--radius-card)" />
    </figure>
    <div>
      <p class="eyebrow">จากชานอ้อย สู่การใช้งานหน้าร้าน</p>
      <h2 class="mt-3 text-2xl font-medium leading-snug text-forest-900 sm:text-3xl">รู้จักวัสดุ เลือกใช้ให้เหมาะ</h2>
      <p class="mt-4 leading-relaxed text-forest-700">ชานอ้อยคือเส้นใยที่เหลือหลังการคั้นน้ำอ้อย หลอดจากวัสดุพืชอาจมีเฉดสีต่างกันเล็กน้อย จึงควรดูตัวอย่างจริงควบคู่กับขนาดและรายละเอียดสินค้า</p>
      <div class="mt-6 divide-y divide-forest-200/60">
        {tips.map((tip) => (
          <div class="py-4 first:pt-0 last:pb-0">
            <h3 class="font-medium text-forest-900">{tip.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-forest-700">{tip.text}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
