---
/// หัวหน้าเพจแบบเดียวกันทุกหน้า (ยกเว้นหน้าแรกที่มี hero ของตัวเอง)
/// พื้นเขียวเข้มต่อจาก header — ทำให้ทุกหน้าเปิดมาแล้วรู้ทันทีว่าอยู่หมวดไหน
interface Props {
  eyebrow: string;
  heading: string;
  intro?: string;
  /// เส้นทางหน้า (breadcrumb) — ตัวสุดท้ายคือหน้าปัจจุบัน ไม่ต้องใส่ href
  crumbs?: { label: string; href?: string }[];
}

const { eyebrow, heading, intro, crumbs } = Astro.props;
---

<section class="bg-gradient-to-br from-forest-800 to-forest-900 text-cream-100">
  <div class="mx-auto max-w-6xl px-5 pt-6 pb-10 sm:px-6 sm:pt-8 sm:pb-12">
    {
      crumbs && (
        <nav aria-label="เส้นทางหน้า" class="mb-6 sm:mb-8">
          <ol class="flex flex-wrap items-center gap-2 text-sm text-cream-200/65">
            {crumbs.map((c, i) => (
              <>
                {i > 0 && <li aria-hidden="true" class="text-cream-200/35">/</li>}
                <li>
                  {c.href ? (
                    <a href={c.href} class="hover:text-cream-50 hover:underline">
                      {c.label}
                    </a>
                  ) : (
                    <span class="text-cream-100" aria-current="page">
                      {c.label}
                    </span>
                  )}
                </li>
              </>
            ))}
          </ol>
        </nav>
      )
    }

    <p class="text-[0.7rem] font-semibold tracking-[0.18em] text-cane-300 uppercase">{eyebrow}</p>
    <h1 class="mt-3 max-w-3xl text-[1.75rem] leading-snug font-medium text-cream-50 sm:text-4xl">
      {heading}
    </h1>
    {intro && <p class="mt-4 max-w-2xl text-base text-pretty text-cream-200/85 sm:text-lg">{intro}</p>}

    <slot />
  </div>
</section>
