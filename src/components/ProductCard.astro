---
import type { Product } from '../data/products';

interface Props {
  product: Product;
}

const { product: p } = Astro.props;
---

<!-- การ์ดมุมมน พื้นอ่อนและปุ่มด้านใน ใช้ตัวเลขขนาดนำการเลือกสินค้า -->
<a
  href={`/products/${p.slug}/`}
  class="group flex flex-col overflow-hidden border border-forest-100 bg-cream-50 shadow-soft transition duration-300 hover:-translate-y-1 hover:border-forest-200 hover:shadow-lg motion-reduce:transform-none"
  style="border-radius: var(--radius-card)"
>
  <div class="flex items-start justify-between gap-4 bg-gradient-to-br from-forest-50/80 to-cream-50 px-5 pt-6 pb-4">
    <div>
      <p class="index-num text-5xl text-forest-900">
        {p.size}<span class="ml-1 font-sans text-base font-medium text-forest-600">มม.</span>
      </p>
      <p class="tabular mt-1 text-xs text-forest-600">ยาว 210 มม.</p>
    </div>
    <img
      src={p.images[0].src}
      alt={p.images[0].alt}
      loading="lazy"
      decoding="async"
      width={p.images[0].width}
      height={p.images[0].height}
      class="h-20 w-20 object-contain transition group-hover:-translate-y-0.5"
    />
  </div>

  <div class="flex flex-1 flex-col px-5 py-4">
    <h3 class="text-base font-medium text-forest-900">{p.useCase}</h3>
    <p class="mt-2 flex-1 text-sm text-forest-700/85">
      {p.drinks.slice(0, 4).join(' · ')}
    </p>

    <dl class="tabular mt-5 flex flex-wrap items-end justify-between gap-3 rounded-2xl bg-forest-50/80 px-3 py-3">
      <div>
        <dt class="text-[0.65rem] tracking-[0.12em] text-forest-500 uppercase">คาร์บอน/หลอด</dt>
        <dd class="text-sm font-semibold text-forest-900">{p.co2PerStraw} ก. CO₂e</dd>
      </div>
      <div class="text-right">
        <dt class="text-[0.65rem] tracking-[0.12em] text-forest-500 uppercase">กล่องใหญ่</dt>
        <dd class="text-sm font-semibold text-forest-900">
          {p.packing[0].pieces.toLocaleString('th-TH')} ชิ้น
        </dd>
      </div>
    </dl>
  </div>

  <p
    class="mx-5 mb-5 rounded-full bg-forest-100/70 px-4 py-3 text-center text-sm font-semibold text-forest-700 transition-colors group-hover:bg-forest-700 group-hover:text-cream-50"
  >
    ดูสเปคและราคาส่ง
  </p>
</a>
