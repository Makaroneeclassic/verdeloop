---
import type { Product } from '../data/products';

interface Props {
  product: Product;
}

const { product: p } = Astro.props;
---

<!-- การ์ดสินค้าแบบ "แผ่นสเปค" — ให้ตัวเลขขนาดเป็นพระเอก
     เพราะลูกค้าจำสินค้าจากตัวเลข 6/8/12 ไม่ได้จำจากรูปหลอดที่หน้าตาเหมือนกันหมด -->
<a
  href={`/products/${p.slug}/`}
  class="group flex flex-col border border-forest-200/70 bg-cream-50 transition hover:border-forest-400"
  style="border-radius: var(--radius-sharp)"
>
  <div class="flex items-start justify-between gap-4 border-b border-forest-100 px-5 pt-5 pb-4">
    <div>
      <p class="index-num text-5xl text-forest-900">
        {p.size}<span class="ml-1 font-sans text-base font-medium text-forest-600">มม.</span>
      </p>
      <p class="tabular mt-1 text-xs text-forest-600">ยาว 210 มม.</p>
    </div>
    <img
      src={p.images[0].src}
      alt={p.images[0].alt}
      loading="lazy"
      decoding="async"
      width={p.images[0].width}
      height={p.images[0].height}
      class="h-20 w-20 object-contain transition group-hover:-translate-y-0.5"
    />
  </div>

  <div class="flex flex-1 flex-col px-5 py-4">
    <h3 class="text-base font-medium text-forest-900">{p.useCase}</h3>
    <p class="mt-2 flex-1 text-sm text-forest-700/85">
      {p.drinks.slice(0, 4).join(' · ')}
    </p>

    <dl class="tabular mt-4 flex items-end justify-between border-t border-dashed border-forest-200 pt-3">
      <div>
        <dt class="text-[0.65rem] tracking-[0.12em] text-forest-500 uppercase">คาร์บอน/หลอด</dt>
        <dd class="text-sm font-semibold text-forest-900">{p.co2PerStraw} ก. CO₂e</dd>
      </div>
      <div class="text-right">
        <dt class="text-[0.65rem] tracking-[0.12em] text-forest-500 uppercase">กล่องใหญ่</dt>
        <dd class="text-sm font-semibold text-forest-900">
          {p.packing[0].pieces.toLocaleString('th-TH')} ชิ้น
        </dd>
      </div>
    </dl>
  </div>

  <p
    class="border-t border-forest-100 px-5 py-3 text-sm font-semibold text-forest-700 group-hover:bg-forest-800 group-hover:text-cream-50"
  >
    ดูสเปคและราคาส่ง
  </p>
</a>
