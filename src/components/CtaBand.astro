---
import { CONTACT } from '../data/products';

interface Props {
  heading?: string;
  sub?: string;
}

const {
  heading = 'อยากลองก่อนสั่งจริง?',
  sub = 'ขอตัวอย่างฟรีไปทดสอบกับเครื่องดื่มของร้านคุณ แช่ทิ้งไว้ดูเองว่าไม่เปื่อยจริงไหม',
} = Astro.props;
---

<!-- CTA แบบเต็มความกว้าง ไม่ใช่กล่องมนลอยกลางหน้า
     จัดชิดซ้ายให้เนื้อหากับปุ่มอยู่คนละฝั่ง อ่านเป็นประโยคต่อเนื่องมากกว่าจัดกลาง -->
<section data-cta class="bg-forest-900 text-cream-100">
  <div class="section-space-sm mx-auto max-w-6xl px-5 sm:px-6">
    <div class="tick-rule mb-7 text-cane-300 sm:mb-9"></div>
    <div class="grid gap-7 lg:grid-cols-2 lg:items-center lg:gap-10">
      <div>
        <h2 class="max-w-lg text-2xl font-medium text-cream-50 sm:text-3xl">
          {heading}
        </h2>
        <p class="mt-3 max-w-xl text-cream-200/80">{sub}</p>
      </div>

      <div class="action-group lg:justify-end">
        <a
          href="/sugarcane-straw/"
          class="bg-cream-100 px-4 py-3 text-sm font-semibold text-forest-900 transition hover:bg-cream-50"
          style="border-radius: var(--radius-pill)"
        >
          ขอตัวอย่างฟรี
        </a>
        
        {/* ปุ่มโทรโผล่เมื่อมีเบอร์จริงเท่านั้น — ยังไม่มีก็เหลือ 2 ปุ่ม ไม่ใช่ปุ่มที่กดแล้วไม่มีอะไรเกิดขึ้น */}
        
      </div>
    </div>
  </div>
</section>
