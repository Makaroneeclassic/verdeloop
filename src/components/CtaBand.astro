---
import { CONTACT } from '../data/products';

interface Props {
  heading?: string;
  sub?: string;
}

const {
  heading = 'อยากลองก่อนสั่งจริง?',
  sub = 'ขอตัวอย่างฟรีไปทดสอบกับเครื่องดื่มของร้านคุณ แช่ทิ้งไว้ดูเองว่าไม่เปื่อยจริงไหม',
} = Astro.props;
---

<!-- CTA แบบเต็มความกว้าง ไม่ใช่กล่องมนลอยกลางหน้า
     จัดชิดซ้ายให้เนื้อหากับปุ่มอยู่คนละฝั่ง อ่านเป็นประโยคต่อเนื่องมากกว่าจัดกลาง -->
<section data-cta class="mt-20 bg-forest-900 text-cream-100">
  <div class="mx-auto max-w-6xl px-4 py-14">
    <div class="tick-rule mb-10 text-cane-300"></div>
    <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
      <div>
        <h2 class="max-w-lg text-2xl font-medium text-cream-50 sm:text-3xl">
          {heading}
        </h2>
        <p class="mt-3 max-w-xl text-cream-200/80">{sub}</p>
      </div>

      <div class="flex flex-wrap gap-3">
        <a
          href="/sample/"
          class="bg-cream-100 px-6 py-3 font-semibold text-forest-900 transition hover:bg-cream-50"
          style="border-radius: var(--radius-sharp)"
        >
          ขอตัวอย่างฟรี
        </a>
        <a
          href={CONTACT.lineUrl}
          data-track="line"
          class="px-6 py-3 font-semibold text-cream-50 ring-1 ring-cream-200/40 transition hover:bg-forest-800"
          style="border-radius: var(--radius-sharp)"
        >
          ทัก LINE {CONTACT.lineId}
        </a>
        {/* ปุ่มโทรโผล่เมื่อมีเบอร์จริงเท่านั้น — ยังไม่มีก็เหลือ 2 ปุ่ม ไม่ใช่ปุ่มที่กดแล้วไม่มีอะไรเกิดขึ้น */}
        {
          CONTACT.phone && (
            <a
              href={CONTACT.phoneHref}
              data-track="phone"
              class="px-6 py-3 font-semibold text-cream-50 ring-1 ring-cream-200/40 transition hover:bg-forest-800"
              style="border-radius: var(--radius-sharp)"
            >
              โทร {CONTACT.phone}
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>
