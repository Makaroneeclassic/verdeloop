# ตัวแปรที่ /api/lead.js กับ /admin.js ใช้ — ตั้งค่าจริงใน Vercel > Settings > Environment Variables
# ห้ามใส่ค่าจริงในไฟล์นี้ (ไฟล์นี้ commit ได้ ส่วน .env กับ .env.local ห้าม)
#
# ดึงค่าจริงลงมาทำงานในเครื่อง: npx vercel env pull .env.local

# --- ฐานข้อมูลลีด (Neon Postgres ผ่าน Vercel Marketplace) ---
# นี่คือที่เก็บลีดตัวหลัก ตั้งค่าอัตโนมัติตอน `npx vercel integration add neon`
# เลือก region สิงคโปร์ให้ตรงกับ regions: ["sin1"] ใน vercel.json
#
# ไม่ตั้ง = ลีดไม่ถูกบันทึก เหลือแค่ข้อความ LINE เป็นสำเนาเดียว (ข้อความ LINE จะขึ้นเตือนให้)
DATABASE_URL=
# ต่อตรงไม่ผ่าน pooler — ใช้เฉพาะตอนสร้างตาราง (scripts/db-init.mjs) คำสั่ง DDL ทำผ่าน pooler ไม่ได้
DATABASE_URL_UNPOOLED=

# --- เข้าหน้าหลังบ้าน /admin ---
# ตั้งเอง ไม่ใช่ของบริการไหน ตั้งรหัสยาว ๆ เพราะหน้านี้เปิดดูข้อมูลส่วนบุคคลของลูกค้าได้ทั้งหมด
# ไม่ตั้ง 2 ตัวนี้ = หน้าหลังบ้านตอบ 500 (ตั้งใจให้ปิดไว้ ดีกว่าเผลอเปิดสาธารณะ)
ADMIN_USER=
ADMIN_PASSWORD=

# --- แจ้งเตือนเข้า LINE (Messaging API push) ---
# เป็นแค่ "การแจ้งเตือน" ไม่ใช่ที่เก็บ — ถ้า push ล้มแต่ DB เก็บได้ ฟอร์มยังตอบสำเร็จตามปกติ
# และแถวนั้นจะขึ้นเตือนบนสุดใน /admin ว่ายังไม่มีใครเห็น
#
# LINE Notify ปิดบริการ 31 มี.ค. 2025 แล้ว จึงต้องใช้ push ผ่าน LINE OA
# token เอาจาก LINE Developers Console > Channel ของ @verdeloop > Messaging API
# (ห้ามใช้ token ของ @2amplus — คนละบริษัท ลีดจะวิ่งผิดที่)
LINE_CHANNEL_ACCESS_TOKEN=
# userId หรือ groupId ปลายทาง (ขึ้นต้นด้วย U หรือ C)
LINE_TO=

# Measurement: public IDs only, never credentials
PUBLIC_GA4_ID=
PUBLIC_GOOGLE_ADS_ID=
PUBLIC_GOOGLE_ADS_LEAD_LABEL=
# Operations secrets
CRON_SECRET=
RATE_LIMIT_SECRET=
# 32-byte key encoded as base64; keep a separate recovery copy
BACKUP_ENCRYPTION_KEY=
BLOB_READ_WRITE_TOKEN=
