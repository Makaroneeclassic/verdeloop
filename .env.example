# ตัวแปรที่ /api/lead.js ใช้ — ตั้งค่าจริงใน Vercel > Settings > Environment Variables
# ห้ามใส่ค่าจริงในไฟล์นี้ (ไฟล์นี้ commit ได้ ส่วน .env ห้าม)

# --- อีเมลแจ้งทีมขาย (Resend) ---
# ไม่ตั้ง = ข้ามการส่งอีเมล ระบบยังทำงานด้วย LINE ทางเดียว
RESEND_API_KEY=re_xxxxxxxxxxxx
LEAD_EMAIL_TO=info@verdeloopthailand.com     # ใส่หลายอีเมลได้ คั่นด้วยคอมมา
LEAD_EMAIL_FROM=lead@verdeloopthailand.com   # โดเมนต้อง verify ใน Resend ก่อน

# --- แจ้งเตือนเข้า LINE (Messaging API push) ---
# LINE Notify ปิดบริการ 31 มี.ค. 2025 แล้ว จึงต้องใช้ push ผ่าน LINE OA
# token เอาจาก LINE Developers Console > Channel ของ @verdeloop > Messaging API
# (ห้ามใช้ token ของ @2amplus — คนละบริษัท ลีดจะวิ่งผิดที่)
LINE_CHANNEL_ACCESS_TOKEN=
# userId หรือ groupId ปลายทาง (ขึ้นต้นด้วย U หรือ C)
LINE_TO=
